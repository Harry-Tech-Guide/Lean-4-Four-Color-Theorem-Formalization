import FourColorTheorem.Math.Batch.CRunner14

set_option maxHeartbeats 0
set_option maxRecDepth 10000000

namespace Math
namespace Batch

open FastReducer

def cbatch52_indices : List Nat :=
  [220, 221, 225]

def mid_220_1 : Nat := 
theorem cert_config_220_step1 : KernelReducer.checkStepInit 220 3 mid_220_1 = true := by kernel_rfl
theorem cert_config_220_step2 : KernelReducer.checkStepFinalD 220 117 mid_220_1 = true := by kernel_rfl
theorem cert_config_220_c_red : checkIdxCFast14 (buildSMData 14 sharedPow3) 220 = true :=
  KernelReducer.verifyIdxC_of_D 220 (KernelReducer.verifyIdxD_of_split2 220 3 117 mid_220_1 rfl cert_config_220_step1 cert_config_220_step2)

def mid_221_1 : Nat := 
theorem cert_config_221_step1 : KernelReducer.checkStepInit 221 4 mid_221_1 = true := by kernel_rfl
theorem cert_config_221_step2 : KernelReducer.checkStepFinalD 221 116 mid_221_1 = true := by kernel_rfl
theorem cert_config_221_c_red : checkIdxCFast14 (buildSMData 14 sharedPow3) 221 = true :=
  KernelReducer.verifyIdxC_of_D 221 (KernelReducer.verifyIdxD_of_split2 221 4 116 mid_221_1 rfl cert_config_221_step1 cert_config_221_step2)

def mid_225_1 : Nat := 
theorem cert_config_225_step1 : KernelReducer.checkStepInit 225 3 mid_225_1 = true := by kernel_rfl
theorem cert_config_225_step2 : KernelReducer.checkStepFinalD 225 117 mid_225_1 = true := by kernel_rfl
theorem cert_config_225_c_red : checkIdxCFast14 (buildSMData 14 sharedPow3) 225 = true :=
  KernelReducer.verifyIdxC_of_D 225 (KernelReducer.verifyIdxD_of_split2 225 3 117 mid_225_1 rfl cert_config_225_step1 cert_config_225_step2)

theorem cert_cbatch52_r14 : checkCRingBatch14 cbatch52_indices = true := by
  dsimp only [cbatch52_indices, checkCRingBatch14, List.all]
  rw [cert_config_220_c_red, cert_config_221_c_red, cert_config_225_c_red]
  rfl

end Batch
end Math
