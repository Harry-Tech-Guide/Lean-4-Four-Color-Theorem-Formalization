import FourColorTheorem.Math.Batch.CRunner14

set_option maxHeartbeats 0
set_option maxRecDepth 10000000

namespace Math
namespace Batch

open FastReducer

def cbatch50_indices : List Nat :=
  [202, 206, 212]

def mid_202_1 : Nat := 
theorem cert_config_202_step1 : KernelReducer.checkStepInit 202 3 mid_202_1 = true := by kernel_rfl
theorem cert_config_202_step2 : KernelReducer.checkStepFinalC 202 117 mid_202_1 = true := by kernel_rfl
theorem cert_config_202_c_red : checkIdxCFast14 (buildSMData 14 sharedPow3) 202 = true :=
  KernelReducer.verifyIdxC_of_split2 202 3 117 mid_202_1 rfl cert_config_202_step1 cert_config_202_step2

def mid_206_1 : Nat := 
theorem cert_config_206_step1 : KernelReducer.checkStepInit 206 4 mid_206_1 = true := by kernel_rfl
theorem cert_config_206_step2 : KernelReducer.checkStepFinalD 206 116 mid_206_1 = true := by kernel_rfl
theorem cert_config_206_c_red : checkIdxCFast14 (buildSMData 14 sharedPow3) 206 = true :=
  KernelReducer.verifyIdxC_of_D 206 (KernelReducer.verifyIdxD_of_split2 206 4 116 mid_206_1 rfl cert_config_206_step1 cert_config_206_step2)

def mid_212_1 : Nat := 
theorem cert_config_212_step1 : KernelReducer.checkStepInit 212 2 mid_212_1 = true := by kernel_rfl
theorem cert_config_212_step2 : KernelReducer.checkStepFinalC 212 118 mid_212_1 = true := by kernel_rfl
theorem cert_config_212_c_red : checkIdxCFast14 (buildSMData 14 sharedPow3) 212 = true :=
  KernelReducer.verifyIdxC_of_split2 212 2 118 mid_212_1 rfl cert_config_212_step1 cert_config_212_step2

theorem cert_cbatch50_r14 : checkCRingBatch14 cbatch50_indices = true := by
  dsimp only [cbatch50_indices, checkCRingBatch14, List.all]
  rw [cert_config_202_c_red, cert_config_206_c_red, cert_config_212_c_red]
  rfl

end Batch
end Math
