section K5MinorTheorem

/-- Edge-node walk reachability from `x` staying within a predicate `P`. -/
inductive ReachENIn {D : Type} (e n : Perm D) (P : D → Prop) (x : D) : D → Prop
  | refl : P x → ReachENIn e n P x x
  | step_n_fwd {y : D} : ReachENIn e n P x y → P (n.f y) → ReachENIn e n P x (n.f y)
  | step_n_bwd {y : D} : ReachENIn e n P x y → P (n.inv y) → ReachENIn e n P x (n.inv y)
  | step_e {y : D} : ReachENIn e n P x y → P (e.f y) → ReachENIn e n P x (e.f y)

theorem reachENIn_left {D : Type} {e n : Perm D} {P : D → Prop} {x y : D}
    (h : ReachENIn e n P x y) : P x := by
  induction h with
  | refl hx => exact hx
  | step_n_fwd _ _ ih => exact ih
  | step_n_bwd _ _ ih => exact ih
  | step_e _ _ ih => exact ih

theorem reachENIn_right {D : Type} {e n : Perm D} {P : D → Prop} {x y : D}
    (h : ReachENIn e n P x y) : P y := by
  induction h with
  | refl hx => exact hx
  | step_n_fwd _ hy _ => exact hy
  | step_n_bwd _ hy _ => exact hy
  | step_e _ hy _ => exact hy

theorem reachENIn_trans {D : Type} {e n : Perm D} {P : D → Prop} {x y z : D}
    (h1 : ReachENIn e n P x y) (h2 : ReachENIn e n P y z) : ReachENIn e n P x z := by
  induction h2 with
  | refl _ => exact h1
  | step_n_fwd _ hy ih => exact ReachENIn.step_n_fwd ih hy
  | step_n_bwd _ hy ih => exact ReachENIn.step_n_bwd ih hy
  | step_e _ hy ih => exact ReachENIn.step_e ih hy

theorem reachENIn_of_sameOrbit {D : Type} (e n : Perm D) (P : D → Prop)
    (hP_node : ∀ z, P (n.f z) ↔ P z) {x y : D} (hx : P x) (hso : SameOrbit n x y) :
    ReachENIn e n P x y := by
  rcases hso with ⟨k, hk⟩
  subst hk
  induction k with
  | zero => exact ReachENIn.refl hx
  | succ k ih =>
    rw [Perm.iter_succ]
    exact ReachENIn.step_n_fwd ih ((hP_node _).mpr (reachENIn_right ih))

private theorem reachENIn_sameOrbit_or_crossing_edge (H : Hypermap) [DecidableEq H.Dart]
    (darts : List H.Dart) (h_comp : ∀ d, d ∈ darts)
    (P : H.Dart → Prop) {x y : H.Dart} (h : ReachENIn H.edge H.node P x y) :
    SameOrbit H.node x y ∨ ∃ d : H.Dart, P d ∧ P (H.edge.f d) ∧ ¬ SameOrbit H.node d (H.edge.f d) := by
  induction h with
  | refl _ => exact Or.inl (sameOrbit_refl H.node x)
  | step_n_fwd _ _ ih =>
    rcases ih with hso | hw
    · exact Or.inl (sameOrbit_trans H.node hso (sameOrbit_step H.node rfl))
    · exact Or.inr hw
  | step_n_bwd _ _ ih =>
    rcases ih with hso | hw
    · exact Or.inl (sameOrbit_trans H.node hso (sameOrbit_inv_step_of_complete H.node darts h_comp _))
    · exact Or.inr hw
  | @step_e z h hefz ih =>
    rcases ih with hso | hw
    · by_cases hsame : SameOrbit H.node z (H.edge.f z)
      · exact Or.inl (sameOrbit_trans H.node hso hsame)
      · exact Or.inr ⟨z, reachENIn_right h, hefz, hsame⟩
    · exact Or.inr hw

private theorem sameOrbit_node_preserves_cls (H : Hypermap) (cls : H.Dart → Option (Fin 5))
    (h_cls_node : ∀ d, cls (H.node.f d) = cls d) {x y : H.Dart} (hso : SameOrbit H.node x y) :
    cls x = cls y := by
  rcases hso with ⟨k, hk⟩
  subst hk
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [Perm.iter_succ, h_cls_node]
    exact ih

/-- A planar hypermap cannot contain a `K₅` minor over 5 connected node-invariant branch sets. -/
theorem no_K5_minor_of_isPlanar (H : Hypermap) [DecidableEq H.Dart]
    (darts : List H.Dart) (h_nodup : darts.Nodup) (h_comp : ∀ d, d ∈ darts)
    (h_planar : H.isPlanar darts.length darts = true)
    (cls : H.Dart → Option (Fin 5))
    (h_cls_node : ∀ d, cls (H.node.f d) = cls d)
    (h_conn : ∀ (i : Fin 5) (x y : H.Dart),
      cls x = some i → cls y = some i → ReachENIn H.edge H.node (fun z => cls z = some i) x y)
    (e_dart : (i j : Fin 5) → i < j → H.Dart)
    (he_i : ∀ i j (h : i < j), cls (e_dart i j h) = some i)
    (he_j : ∀ i j (h : i < j), cls (H.edge.f (e_dart i j h)) = some j) :
    False := by
  by_cases h_contract :
      ∃ d : H.Dart, (∃ i : Fin 5, cls d = some i ∧ cls (H.edge.f d) = some i) ∧ ¬ SameOrbit H.node d (H.edge.f d)
  · rcases h_contract with ⟨d, ⟨i, hcd, hced⟩, h_not_same⟩
    have hd_ne : H.edge.f d ≠ d := fun h => h_not_same ⟨0, h.symm⟩
    let H' := H.contractEdgeSubtype d
    let darts' : List H'.Dart := subDarts darts [d, H.edge.f d]
    have h_nd' : darts'.Nodup := subDarts_nodup darts [d, H.edge.f d] h_nodup
    have h_comp' : ∀ z : H'.Dart, z ∈ darts' := fun z => (mem_subDarts darts [d, H.edge.f d] z).mpr (h_comp z.val)
    have h_smaller : darts'.length < darts.length :=
      exciseSubtype_strictly_smaller darts [d, H.edge.f d] ⟨d, h_comp d, List.mem_cons_self⟩
    have h_planar' : H'.isPlanar darts'.length darts' = true :=
      contractEdgeSubtype_isPlanar H darts h_nodup h_comp (Nat.le_refl _) h_planar d hd_ne
        darts' h_nd' h_comp' (Nat.le_refl _)
    let cls' : H'.Dart → Option (Fin 5) := fun z => cls z.val
    have h_cls'_node : ∀ z : H'.Dart, cls' (H'.node.f z) = cls' z := by
      intro z
      have hso' : SameOrbit H'.node z (H'.node.f z) := sameOrbit_step H'.node rfl
      rw [contractEdgeSubtype_node_sameOrbit_iff H darts h_comp d h_not_same] at hso'
      rcases hso' with hso | ⟨hz, hnz⟩
      · exact (sameOrbit_node_preserves_cls H cls h_cls_node hso).symm
      · have h_in_i : ∀ u : H.Dart,
            (SameOrbit H.node u d ∨ SameOrbit H.node u (H.edge.f d)) → cls u = some i := by
          intro u hu
          rcases hu with hud | hub
          · exact (sameOrbit_node_preserves_cls H cls h_cls_node hud).trans hcd
          · exact (sameOrbit_node_preserves_cls H cls h_cls_node hub).trans hced
        exact (h_in_i _ hnz).trans (h_in_i _ hz).symm
    have h_cls'_node_iff : ∀ k : Fin 5, ∀ z : H'.Dart, cls' (H'.node.f z) = some k ↔ cls' z = some k := by
      intro k z; rw [h_cls'_node z]
    have h_edart_mem : ∀ (a b : Fin 5) (hab : a < b), ¬ e_dart a b hab ∈ [d, H.edge.f d] := by
      intro a b hab hm
      rcases List.mem_cons.mp hm with h1 | h2
      · have hca := he_i a b hab
        rw [h1, hcd] at hca
        have heq_ai : a = i := Option.some.inj hca.symm
        have hcb := he_j a b hab
        rw [h1, hced] at hcb
        have heq_bi : b = i := Option.some.inj hcb.symm
        omega
      · have h2' : e_dart a b hab = H.edge.f d := by simpa using h2
        have hca := he_i a b hab
        rw [h2', hced] at hca
        have heq_ai : a = i := Option.some.inj hca.symm
        have hcb := he_j a b hab
        rw [h2', H.edge_involution, hcd] at hcb
        have heq_bi : b = i := Option.some.inj hcb.symm
        omega
    let e_dart' : (a b : Fin 5) → a < b → H'.Dart := fun a b hab =>
      ⟨e_dart a b hab, h_edart_mem a b hab⟩
    have he'_a : ∀ a b (h : a < b), cls' (e_dart' a b h) = some a := fun a b h => he_i a b h
    have he'_b : ∀ a b (h : a < b), cls' (H'.edge.f (e_dart' a b h)) = some b := by
      intro a b h
      change cls (H'.edge.f (e_dart' a b h)).val = some b
      rw [contractEdgeSubtype_edge_val H d (e_dart' a b h)]
      exact he_j a b h
    have h_conn' : ∀ (k : Fin 5) (x' y' : H'.Dart),
        cls' x' = some k → cls' y' = some k →
          ReachENIn H'.edge H'.node (fun z => cls' z = some k) x' y' := by
      intro k x' y' hkx _
      have hw : ReachENIn H.edge H.node (fun z => cls z = some k) x'.val y'.val :=
        h_conn k x'.val y'.val hkx (by assumption)
      have h_lift : ∀ y : H.Dart, ReachENIn H.edge H.node (fun z => cls z = some k) x'.val y →
          (∀ hy : ¬ y ∈ [d, H.edge.f d],
            ReachENIn H'.edge H'.node (fun z => cls' z = some k) x' ⟨y, hy⟩) ∧
          ((SameOrbit H.node y d ∨ SameOrbit H.node y (H.edge.f d)) →
            ∃ v' : H'.Dart, (SameOrbit H.node v'.val d ∨ SameOrbit H.node v'.val (H.edge.f d)) ∧
              ReachENIn H'.edge H'.node (fun z => cls' z = some k) x' v') := by
        intro y hyw
        induction hyw with
        | refl _ =>
          constructor
          · intro hy
            have heq : (⟨x'.val, hy⟩ : H'.Dart) = x' := Subtype.ext rfl
            rw [heq]
            exact ReachENIn.refl hkx
          · intro hz
            exact ⟨x', hz, ReachENIn.refl hkx⟩
        | @step_n_fwd z _ _ ih =>
          have hso_z : SameOrbit H.node z (H.node.f z) := sameOrbit_step H.node rfl
          have h_in_iff : (SameOrbit H.node (H.node.f z) d ∨ SameOrbit H.node (H.node.f z) (H.edge.f d)) ↔
              (SameOrbit H.node z d ∨ SameOrbit H.node z (H.edge.f d)) := by
            constructor
            · rintro (hd | hb)
              · exact Or.inl (sameOrbit_trans H.node hso_z hd)
              · exact Or.inr (sameOrbit_trans H.node hso_z hb)
            · rintro (hd | hb)
              · exact Or.inl (sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp hso_z) hd)
              · exact Or.inr (sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp hso_z) hb)
          constructor
          · intro hy'
            by_cases hy : z ∈ [d, H.edge.f d]
            · have hz_in : SameOrbit H.node z d ∨ SameOrbit H.node z (H.edge.f d) := by
                rcases List.mem_cons.mp hy with rfl | hy2
                · exact Or.inl (sameOrbit_refl H.node _)
                · have hzb : z = H.edge.f d := by simpa using hy2
                  rw [hzb]; exact Or.inr (sameOrbit_refl H.node _)
              rcases ih.2 hz_in with ⟨v', hv'_in, hv'_reach⟩
              have hy'_in : SameOrbit H.node (⟨H.node.f z, hy'⟩ : H'.Dart).val d ∨
                  SameOrbit H.node (⟨H.node.f z, hy'⟩ : H'.Dart).val (H.edge.f d) := h_in_iff.mpr hz_in
              have hso' : SameOrbit H'.node v' ⟨H.node.f z, hy'⟩ :=
                (contractEdgeSubtype_node_sameOrbit_iff H darts h_comp d h_not_same v' ⟨H.node.f z, hy'⟩).mpr
                  (Or.inr ⟨hv'_in, hy'_in⟩)
              exact reachENIn_trans hv'_reach
                (reachENIn_of_sameOrbit H'.edge H'.node (fun u => cls' u = some k) (h_cls'_node_iff k)
                  (reachENIn_right (P := fun u => cls' u = some k) hv'_reach) hso')
            · have h_reach_z := ih.1 hy
              have hso' : SameOrbit H'.node ⟨z, hy⟩ ⟨H.node.f z, hy'⟩ :=
                (contractEdgeSubtype_node_sameOrbit_iff H darts h_comp d h_not_same ⟨z, hy⟩ ⟨H.node.f z, hy'⟩).mpr
                  (Or.inl hso_z)
              exact reachENIn_trans h_reach_z
                (reachENIn_of_sameOrbit H'.edge H'.node (fun u => cls' u = some k) (h_cls'_node_iff k)
                  (reachENIn_right (P := fun u => cls' u = some k) h_reach_z) hso')
          · intro hnf_in
            exact ih.2 (h_in_iff.mp hnf_in)
        | @step_n_bwd z _ _ ih =>
          have hso_z : SameOrbit H.node z (H.node.inv z) := sameOrbit_inv_step_of_complete H.node darts h_comp z
          have h_in_iff : (SameOrbit H.node (H.node.inv z) d ∨ SameOrbit H.node (H.node.inv z) (H.edge.f d)) ↔
              (SameOrbit H.node z d ∨ SameOrbit H.node z (H.edge.f d)) := by
            constructor
            · rintro (hd | hb)
              · exact Or.inl (sameOrbit_trans H.node hso_z hd)
              · exact Or.inr (sameOrbit_trans H.node hso_z hb)
            · rintro (hd | hb)
              · exact Or.inl (sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp hso_z) hd)
              · exact Or.inr (sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp hso_z) hb)
          constructor
          · intro hy'
            by_cases hy : z ∈ [d, H.edge.f d]
            · have hz_in : SameOrbit H.node z d ∨ SameOrbit H.node z (H.edge.f d) := by
                rcases List.mem_cons.mp hy with rfl | hy2
                · exact Or.inl (sameOrbit_refl H.node _)
                · have hzb : z = H.edge.f d := by simpa using hy2
                  rw [hzb]; exact Or.inr (sameOrbit_refl H.node _)
              rcases ih.2 hz_in with ⟨v', hv'_in, hv'_reach⟩
              have hy'_in := h_in_iff.mpr hz_in
              have hso' : SameOrbit H'.node v' ⟨H.node.inv z, hy'⟩ :=
                (contractEdgeSubtype_node_sameOrbit_iff H darts h_comp d h_not_same v' ⟨H.node.inv z, hy'⟩).mpr
                  (Or.inr ⟨hv'_in, hy'_in⟩)
              exact reachENIn_trans hv'_reach
                (reachENIn_of_sameOrbit H'.edge H'.node (fun u => cls' u = some k) (h_cls'_node_iff k)
                  (reachENIn_right (P := fun u => cls' u = some k) hv'_reach) hso')
            · have h_reach_z := ih.1 hy
              have hso' : SameOrbit H'.node ⟨z, hy⟩ ⟨H.node.inv z, hy'⟩ :=
                (contractEdgeSubtype_node_sameOrbit_iff H darts h_comp d h_not_same ⟨z, hy⟩ ⟨H.node.inv z, hy'⟩).mpr
                  (Or.inl hso_z)
              exact reachENIn_trans h_reach_z
                (reachENIn_of_sameOrbit H'.edge H'.node (fun u => cls' u = some k) (h_cls'_node_iff k)
                  (reachENIn_right (P := fun u => cls' u = some k) h_reach_z) hso')
          · intro hinv_in
            exact ih.2 (h_in_iff.mp hinv_in)
        | @step_e z _ hefz ih =>
          have h_edge_mem_iff : ¬ H.edge.f z ∈ [d, H.edge.f d] ↔ ¬ z ∈ [d, H.edge.f d] := by
            constructor
            · intro hnot hz
              apply hnot
              rcases List.mem_cons.mp hz with hzd | hz2
              · rw [hzd]; exact List.mem_cons_of_mem d List.mem_cons_self
              · have hzb : z = H.edge.f d := by simpa using hz2
                rw [hzb, H.edge_involution]
                exact List.mem_cons_self
            · intro hnot hz
              apply hnot
              rcases List.mem_cons.mp hz with heq | hz2
              · have : z = H.edge.f d := by
                  calc
                    z = H.edge.f (H.edge.f z) := (H.edge_involution _).symm
                    _ = H.edge.f d := congrArg H.edge.f heq
                rw [this]; exact List.mem_cons_of_mem d List.mem_cons_self
              · have heq : H.edge.f z = H.edge.f d := by simpa using hz2
                have : z = d := perm_f_inj H.edge heq
                rw [this]; exact List.mem_cons_self
          have h_part1 : ∀ hy' : ¬ H.edge.f z ∈ [d, H.edge.f d],
              ReachENIn H'.edge H'.node (fun u => cls' u = some k) x' ⟨H.edge.f z, hy'⟩ := by
            intro hy'
            have hy := h_edge_mem_iff.mp hy'
            have h_reach_z := ih.1 hy
            have heval : H'.edge.f ⟨z, hy⟩ = ⟨H.edge.f z, hy'⟩ :=
              Subtype.ext (contractEdgeSubtype_edge_val H d ⟨z, hy⟩)
            rw [← heval]
            exact ReachENIn.step_e h_reach_z (by rw [heval]; exact hefz)
          refine ⟨h_part1, ?_⟩
          intro hefz_in
          by_cases hz : z ∈ [d, H.edge.f d]
          · have hz_in : SameOrbit H.node z d ∨ SameOrbit H.node z (H.edge.f d) := by
              rcases List.mem_cons.mp hz with hzd | hz2
              · rw [hzd]; exact Or.inl (sameOrbit_refl H.node _)
              · have hzb : z = H.edge.f d := by simpa using hz2
                rw [hzb]; exact Or.inr (sameOrbit_refl H.node _)
            exact ih.2 hz_in
          · have hy' : ¬ H.edge.f z ∈ [d, H.edge.f d] := h_edge_mem_iff.mpr hz
            exact ⟨⟨H.edge.f z, hy'⟩, hefz_in, h_part1 hy'⟩
      have heq_y : (⟨y'.val, y'.property⟩ : H'.Dart) = y' := Subtype.ext rfl
      rw [← heq_y]
      exact (h_lift y'.val hw).1 y'.property
    exact no_K5_minor_of_isPlanar H' darts' h_nd' h_comp' h_planar' cls' h_cls'_node h_conn' e_dart' he'_a he'_b
  · let v : Fin 5 → H.Dart := fun i =>
      if hi : i.val < 4 then e_dart i ⟨4, by omega⟩ hi else H.edge.f (e_dart 0 4 (by decide))
    have hv_cls : ∀ i : Fin 5, cls (v i) = some i := by
      intro i
      dsimp only [v]
      split
      · rename_i hi
        exact he_i i ⟨4, by omega⟩ hi
      · rename_i hi
        have hi4 : i = 4 := Fin.ext (by omega)
        subst hi4
        exact he_j 0 4 (by decide)
    have hv_distinct : ∀ i j : Fin 5, i ≠ j → ¬ SameOrbit H.node (v i) (v j) := by
      intro i j hij hso
      have h_eq := sameOrbit_node_preserves_cls H cls h_cls_node hso
      rw [hv_cls i, hv_cls j] at h_eq
      exact hij (Option.some.inj h_eq)
    have h_same_cls_orbit : ∀ (i : Fin 5) (x y : H.Dart),
        cls x = some i → cls y = some i → SameOrbit H.node x y := by
      intro i x y hx hy
      rcases reachENIn_sameOrbit_or_crossing_edge H darts h_comp (fun z => cls z = some i)
          (h_conn i x y hx hy) with hso | ⟨d, hcd, hced, hnot⟩
      · exact hso
      · exact False.elim (h_contract ⟨d, ⟨i, hcd, hced⟩, hnot⟩)
    have he_i' : ∀ i j (h : i < j), SameOrbit H.node (e_dart i j h) (v i) :=
      fun i j h => h_same_cls_orbit i _ _ (he_i i j h) (hv_cls i)
    have he_j' : ∀ i j (h : i < j), SameOrbit H.node (H.edge.f (e_dart i j h)) (v j) :=
      fun i j h => h_same_cls_orbit j _ _ (he_j i j h) (hv_cls j)
    exact no_K5_subgraph_of_isPlanar H darts h_nodup h_comp h_planar v hv_distinct e_dart he_i' he_j'
termination_by darts.length

end K5MinorTheorem

end Hypermap
