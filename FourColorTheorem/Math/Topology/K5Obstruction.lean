section K5OrbitHelpers

/-- Orbit equivalence generated by forward iteration of a permutation `p`. -/
def SameOrbit {D : Type} (p : Perm D) (x y : D) : Prop :=
  ∃ k : Nat, Perm.iter p k x = y

theorem sameOrbit_refl {D : Type} (p : Perm D) (x : D) : SameOrbit p x x :=
  ⟨0, rfl⟩

theorem sameOrbit_step {D : Type} (p : Perm D) {x y : D} (h : p.f x = y) :
    SameOrbit p x y :=
  ⟨1, by simpa [Perm.iter] using h⟩

theorem sameOrbit_trans {D : Type} (p : Perm D) {x y z : D}
    (h1 : SameOrbit p x y) (h2 : SameOrbit p y z) : SameOrbit p x z := by
  rcases h1 with ⟨k1, hk1⟩
  rcases h2 with ⟨k2, hk2⟩
  refine ⟨k2 + k1, ?_⟩
  rw [Perm.iter_add, hk1, hk2]

private theorem perm_f_inj {D : Type} (p : Perm D) {x y : D} (h : p.f x = p.f y) : x = y := by
  calc
    x = p.inv (p.f x) := (p.left_inv x).symm
    _ = p.inv (p.f y) := congrArg p.inv h
    _ = y := p.left_inv y

private theorem perm_iter_shift {D : Type} (p : Perm D) :
    ∀ (n : Nat) (z : D), Perm.iter p (n + 1) z = Perm.iter p n (p.f z)
  | 0, _ => rfl
  | n + 1, z => by
    rw [Perm.iter_succ, perm_iter_shift p n z, ← Perm.iter_succ]

private theorem iter_symm_eq_self {D : Type} (p : Perm D) :
    ∀ (k : Nat) (x : D), Perm.iter p.symm k (Perm.iter p k x) = x
  | 0, _ => rfl
  | k + 1, x => by
    rw [Perm.iter_succ]
    change Perm.iter p.symm (k + 1) (p.f (Perm.iter p k x)) = x
    rw [perm_iter_shift p.symm k (p.f (Perm.iter p k x))]
    change Perm.iter p.symm k (p.inv (p.f (Perm.iter p k x))) = x
    rw [p.left_inv]
    exact iter_symm_eq_self p k x

theorem sameOrbit_symm_perm {D : Type} (p : Perm D) {x y : D} :
    SameOrbit p.symm x y ↔ SameOrbit p y x := by
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    have h := iter_symm_eq_self p.symm k x
    change Perm.iter p k (Perm.iter p.symm k x) = x at h
    rw [hk] at h
    exact h
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    have h := iter_symm_eq_self p k y
    rw [hk] at h
    exact h

private theorem orbitClosesWithin_imp_exists_pos_iter {D : Type} (p : Perm D) :
    ∀ (fuel : Nat) (start cur : D),
      orbitClosesWithin p start cur fuel →
        ∃ m : Nat, Perm.iter p (m + 1) cur = start
  | 0, _, _, h => False.elim h
  | fuel + 1, start, cur, h => by
    rcases h with heq | hrest
    · exact ⟨0, by simpa [Perm.iter] using heq⟩
    · rcases orbitClosesWithin_imp_exists_pos_iter p fuel start (p.f cur) hrest with ⟨m, hm⟩
      refine ⟨m + 1, ?_⟩
      rw [perm_iter_shift p (m + 1) cur]
      exact hm

private theorem iter_mul_eq_self {D : Type} (p : Perm D) (d : D) (M : Nat)
    (hM : Perm.iter p M d = d) :
    ∀ q : Nat, Perm.iter p (q * M) d = d
  | 0 => by rw [Nat.zero_mul]; rfl
  | q + 1 => by
    rw [Nat.succ_mul, Nat.add_comm (q * M) M, Perm.iter_add, iter_mul_eq_self p d M hM q, hM]

theorem sameOrbit_symm_of_complete {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ d, d ∈ darts) {x y : D}
    (hxy : SameOrbit p x y) : SameOrbit p y x := by
  have hcl := orbitClosesWithin_of_complete p darts h_comp x
  rcases orbitClosesWithin_imp_exists_pos_iter p darts.length x x hcl with ⟨m, hm⟩
  rcases hxy with ⟨k, hk⟩
  have hk_le : k ≤ k * (m + 1) := by
    calc
      k = k * 1 := (Nat.mul_one k).symm
      _ ≤ k * (m + 1) := Nat.mul_le_mul_left k (Nat.succ_le_succ (Nat.zero_le m))
  refine ⟨k * (m + 1) - k, ?_⟩
  rw [← hk, ← Perm.iter_add, Nat.sub_add_cancel hk_le]
  exact iter_mul_eq_self p x (m + 1) hm k

theorem sameOrbit_inv_step_of_complete {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ d, d ∈ darts) (x : D) :
    SameOrbit p x (p.inv x) := by
  apply sameOrbit_symm_of_complete p darts h_comp
  exact sameOrbit_step p (p.right_inv x)

theorem sameOrbit_iff_mem_getOrbit {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ d, d ∈ darts) {fuel : Nat} (h_fuel : darts.length ≤ fuel)
    (x y : D) : SameOrbit p x y ↔ y ∈ getOrbit p fuel x := by
  have hcl : orbitClosesWithin p x x fuel :=
    orbitClosesWithin_mono p x x (orbitClosesWithin_of_complete p darts h_comp x) h_fuel
  rw [mem_getOrbit_iff_exists_iter p fuel x y hcl]
  constructor
  · rintro ⟨k, hk⟩; exact ⟨k, hk.symm⟩
  · rintro ⟨k, hk⟩; exact ⟨k, hk.symm⟩

private theorem contains_decEq_eq_true_iff {α : Type} [DecidableEq α] (l : List α) (x : α) :
    (@List.contains α (@instBEqOfDecidableEq α inferInstance) l x = true) ↔ x ∈ l := by
  induction l with
  | nil =>
    constructor
    · intro h; dsimp [List.contains, List.elem] at h; cases h
    · intro h; cases h
  | cons a as ih =>
    dsimp [List.contains, List.elem]
    cases heq : (@instBEqOfDecidableEq α inferInstance).beq x a with
    | true =>
      have hx : x = a := of_decide_eq_true heq
      subst hx
      constructor
      · intro _; exact List.mem_cons_self
      · intro _; rfl
    | false =>
      have hx : x ≠ a := fun h => by
        subst h
        have htr : (@instBEqOfDecidableEq α inferInstance).beq x x = true := decide_eq_true rfl
        rw [htr] at heq; cases heq
      constructor
      · intro h; exact List.mem_cons_of_mem a (ih.mp h)
      · intro h
        rcases List.mem_cons.mp h with rfl | hm
        · exact False.elim (hx rfl)
        · exact ih.mpr hm

private theorem contains_decEq_eq_false_iff {α : Type} [DecidableEq α] (l : List α) (x : α) :
    (@List.contains α (@instBEqOfDecidableEq α inferInstance) l x = false) ↔ ¬ x ∈ l := by
  cases h : (@List.contains α (@instBEqOfDecidableEq α inferInstance) l x) with
  | true =>
    have hm := (contains_decEq_eq_true_iff l x).mp h
    constructor
    · intro hf; cases hf
    · intro hnm; exact False.elim (hnm hm)
  | false =>
    constructor
    · intro _ hm
      have ht := (contains_decEq_eq_true_iff l x).mpr hm
      rw [ht] at h; cases h
    · intro _; rfl

private theorem length_filter_not_contains_add_le {α : Type} [DecidableEq α] :
    ∀ (g l : List α), g.Nodup → (∀ x ∈ g, x ∈ l) →
      (l.filter (fun x => !(@List.contains α (@instBEqOfDecidableEq α inferInstance) g x))).length + g.length ≤ l.length
  | [], l, _, _ => by
    dsimp [List.length]
    have h_all : ∀ xs : List α,
        (xs.filter (fun _ : α => !false)).length = xs.length := by
      intro xs
      induction xs with
      | nil => rfl
      | cons a as ih =>
        dsimp [List.filter]
        exact congrArg Nat.succ ih
    have h_l : (l.filter (fun _ : α => !false)).length = l.length := h_all l
    change (l.filter (fun _ : α => !false)).length + 0 ≤ l.length
    omega
  | a :: as, l, hnd, hsub => by
    rcases List.nodup_cons.mp hnd with ⟨ha_nmem, has_nd⟩
    have hsub_as : ∀ x ∈ as, x ∈ l := fun x hx => hsub x (List.mem_cons_of_mem a hx)
    have ih := length_filter_not_contains_add_le as l has_nd hsub_as
    let p_as : α → Bool := fun x => !(@List.contains α (@instBEqOfDecidableEq α inferInstance) as x)
    let p_all : α → Bool := fun x => !(@List.contains α (@instBEqOfDecidableEq α inferInstance) (a :: as) x)
    have ha_in_l : a ∈ l := hsub a List.mem_cons_self
    have ha_in_as_false : (@List.contains α (@instBEqOfDecidableEq α inferInstance) as a) = false :=
      (contains_decEq_eq_false_iff as a).mpr ha_nmem
    have hp_as_a : p_as a = true := by dsimp [p_as]; rw [ha_in_as_false]; rfl
    have hp_all_a : p_all a = false := by
      dsimp [p_all, List.contains, List.elem]
      have hbeq : (@instBEqOfDecidableEq α inferInstance).beq a a = true := decide_eq_true rfl
      rw [hbeq]
      rfl
    have h_step : ∀ (xs : List α),
        (xs.filter p_all).length + (if a ∈ xs then 1 else 0) ≤ (xs.filter p_as).length := by
      intro xs
      induction xs with
      | nil => simp
      | cons y ys ihy =>
        dsimp [List.filter]
        by_cases hya : y = a
        · subst hya
          rw [hp_all_a, hp_as_a]
          have hmem_self : y ∈ y :: ys := List.mem_cons_self
          simp only [hmem_self, ↓reduceIte]
          change (ys.filter p_all).length + 1 ≤ (ys.filter p_as).length + 1
          by_cases hyys : y ∈ ys
          · simp only [hyys, ↓reduceIte] at ihy; omega
          · simp only [hyys, ↓reduceIte] at ihy; omega
        · have hp_eq : p_all y = p_as y := by
            dsimp [p_all, p_as, List.contains, List.elem]
            have hbeq : (@instBEqOfDecidableEq α inferInstance).beq y a = false := decide_eq_false hya
            rw [hbeq]
          rw [hp_eq]
          have hmem_iff : a ∈ y :: ys ↔ a ∈ ys := by
            constructor
            · intro h
              rcases List.mem_cons.mp h with h1 | h2
              · exact False.elim (hya h1.symm)
              · exact h2
            · intro h; exact List.mem_cons_of_mem y h
          cases hpy : p_as y with
          | false =>
            dsimp
            by_cases hays : a ∈ ys
            · have ha1 : a ∈ y :: ys := hmem_iff.mpr hays
              simp only [ha1, ↓reduceIte]
              simp only [hays, ↓reduceIte] at ihy
              exact ihy
            · have ha1 : ¬ a ∈ y :: ys := fun h => hays (hmem_iff.mp h)
              simp only [ha1, ↓reduceIte]
              simp only [hays, ↓reduceIte] at ihy
              exact ihy
          | true =>
            dsimp
            change (ys.filter p_all).length + 1 + (if a ∈ y :: ys then 1 else 0) ≤ (ys.filter p_as).length + 1
            by_cases hays : a ∈ ys
            · have ha1 : a ∈ y :: ys := hmem_iff.mpr hays
              simp only [ha1, ↓reduceIte]
              simp only [hays, ↓reduceIte] at ihy
              omega
            · have ha1 : ¬ a ∈ y :: ys := fun h => hays (hmem_iff.mp h)
              simp only [ha1, ↓reduceIte]
              simp only [hays, ↓reduceIte] at ihy
              omega
    have h_a := h_step l
    simp only [ha_in_l, ↓reduceIte] at h_a
    dsimp [List.length]
    change (l.filter p_all).length + (as.length + 1) ≤ l.length
    have ih' : (l.filter p_as).length + as.length ≤ l.length := ih
    omega

theorem countOrbits_three_le_length_aux {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ x, x ∈ darts)
    {fuel : Nat} (h_fuel : darts.length ≤ fuel)
    (h_ge3 : ∀ x : D, 3 ≤ (getOrbit p fuel x).length) :
    ∀ n (l : List D), l.length ≤ n → (∀ x ∈ l, p.f x ∈ l) →
      3 * countOrbits p fuel l ≤ l.length
  | 0, [], _, _ => by simp [countOrbits, countOrbitsAux]
  | 0, _ :: _, hlen, _ => by simp at hlen
  | n + 1, [], _, _ => by simp [countOrbits, countOrbitsAux]
  | n + 1, a :: as, hlen, hl_closed => by
    have hcl : orbitClosesWithin p a a fuel :=
      orbitClosesWithin_mono p a a (orbitClosesWithin_of_complete p darts h_comp a) h_fuel
    rw [countOrbits_eq_one_add_filter_of_mem p fuel (a :: as) a List.mem_cons_self hcl]
    let g := getOrbit p fuel a
    have hg_in_l : ∀ x ∈ g, x ∈ a :: as := by
      intro x hx
      rcases (sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel a x).mpr hx with ⟨k, hk⟩
      subst hk
      clear hx
      induction k with
      | zero => exact List.mem_cons_self
      | succ k ihk =>
        rw [Perm.iter_succ]
        exact hl_closed _ ihk
    have h_sub_le : ((a :: as).filter (fun x => !(@List.contains D (@instBEqOfDecidableEq D inferInstance) g x))).length + g.length ≤ (a :: as).length :=
      length_filter_not_contains_add_le g (a :: as) (getOrbit_nodup p fuel a) hg_in_l
    have hg_ge3 : 3 ≤ g.length := h_ge3 a
    have h_rest_lt : ((a :: as).filter (fun x => !(@List.contains D (@instBEqOfDecidableEq D inferInstance) g x))).length ≤ n := by
      dsimp [List.length] at hlen
      have h_alen : (a :: as).length = as.length + 1 := rfl
      omega
    have h_rest_closed : ∀ x ∈ ((a :: as).filter (fun x => !(@List.contains D (@instBEqOfDecidableEq D inferInstance) g x))),
        p.f x ∈ ((a :: as).filter (fun x => !(@List.contains D (@instBEqOfDecidableEq D inferInstance) g x))) := by
      intro x hx
      rcases List.mem_filter.mp hx with ⟨hx1, hx2⟩
      refine List.mem_filter.mpr ⟨hl_closed x hx1, ?_⟩
      have hbf : (@List.contains D (@instBEqOfDecidableEq D inferInstance) g (p.f x)) = false := by
        apply (contains_decEq_eq_false_iff g (p.f x)).mpr
        intro hmem
        have hnot : ¬ x ∈ g := by
          intro hxm
          have ht := (contains_decEq_eq_true_iff g x).mpr hxm
          change (!(@List.contains D (@instBEqOfDecidableEq D inferInstance) g x)) = true at hx2
          rw [ht] at hx2; cases hx2
        have hso_apx : SameOrbit p a (p.f x) := (sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel a (p.f x)).mpr hmem
        have hso_pxx : SameOrbit p (p.f x) x :=
          sameOrbit_symm_of_complete p darts h_comp (sameOrbit_step p rfl)
        exact hnot ((sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel a x).mp (sameOrbit_trans p hso_apx hso_pxx))
      change (!(@List.contains D (@instBEqOfDecidableEq D inferInstance) g (p.f x))) = true
      rw [hbf]; rfl
    have ih := countOrbits_three_le_length_aux p darts h_comp h_fuel h_ge3 n
      ((a :: as).filter (fun x => !(@List.contains D (@instBEqOfDecidableEq D inferInstance) g x))) h_rest_lt h_rest_closed
    change 3 * (1 + countOrbits p fuel ((a :: as).filter (fun x => !(@List.contains D (@instBEqOfDecidableEq D inferInstance) g x)))) ≤ (a :: as).length
    omega

theorem countOrbits_three_le_length {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ x, x ∈ darts)
    {fuel : Nat} (h_fuel : darts.length ≤ fuel)
    (h_ge3 : ∀ x : D, 3 ≤ (getOrbit p fuel x).length) :
    3 * countOrbits p fuel darts ≤ darts.length :=
  countOrbits_three_le_length_aux p darts h_comp h_fuel h_ge3 darts.length darts (Nat.le_refl _)
    (fun x _ => h_comp (p.f x))

private theorem length_filter_not_pair_of_not_mem {α : Type} [DecidableEq α] (a b : α) :
    ∀ (ws : List α), ¬ a ∈ ws → ¬ b ∈ ws →
      (ws.filter (fun x => !(decide (x = a) || decide (x = b)))).length = ws.length
  | [], _, _ => rfl
  | u :: us, hau, hbu => by
    have hua : u ≠ a := fun h => hau (h ▸ List.mem_cons_self)
    have hub : u ≠ b := fun h => hbu (h ▸ List.mem_cons_self)
    have ih := length_filter_not_pair_of_not_mem a b us
      (fun hm => hau (List.mem_cons_of_mem u hm))
      (fun hm => hbu (List.mem_cons_of_mem u hm))
    dsimp [List.filter]
    have hcond : (!(decide (u = a) || decide (u = b))) = true := by simp [hua, hub]
    rw [hcond]
    dsimp [List.length]
    omega

private theorem length_filter_not_pair_of_one_mem {α : Type} [DecidableEq α] (a b : α) :
    ∀ (ws : List α), ws.Nodup → ¬ a ∈ ws → b ∈ ws →
      (ws.filter (fun x => !(decide (x = a) || decide (x = b)))).length + 1 = ws.length
  | [], _, _, hb => by cases hb
  | z :: zs, hnd, ha, hb => by
    rcases List.nodup_cons.mp hnd with ⟨hz_nmem, hzs_nd⟩
    have ha_zs : ¬ a ∈ zs := fun hm => ha (List.mem_cons_of_mem z hm)
    have hza : z ≠ a := fun h => ha (h ▸ List.mem_cons_self)
    dsimp [List.filter]
    by_cases hzb : z = b
    · subst hzb
      have hcond : (!(decide (z = a) || decide (z = z))) = false := by simp
      rw [hcond, length_filter_not_pair_of_not_mem a z zs ha_zs hz_nmem]
    · have hb_zs : b ∈ zs := by
        rcases List.mem_cons.mp hb with rfl | hm
        · exact False.elim (hzb rfl)
        · exact hm
      have hcond : (!(decide (z = a) || decide (z = b))) = true := by simp [hza, hzb]
      rw [hcond]
      dsimp [List.length]
      have ih := length_filter_not_pair_of_one_mem a b zs hzs_nd ha_zs hb_zs
      omega

private theorem length_filter_ne_two_of_nodup {α : Type} [DecidableEq α] (a b : α) (hab : a ≠ b) :
    ∀ (l : List α), l.Nodup → a ∈ l → b ∈ l →
      (l.filter (fun x => !(decide (x = a) || decide (x = b)))).length + 2 = l.length
  | [], _, ha, _ => by cases ha
  | y :: ys, hnd, ha, hb => by
    rcases List.nodup_cons.mp hnd with ⟨hy_nmem, hys_nd⟩
    dsimp [List.filter]
    by_cases hya : y = a
    · subst hya
      have hb_ys : b ∈ ys := by
        rcases List.mem_cons.mp hb with rfl | hm
        · exact False.elim (hab rfl)
        · exact hm
      have hcond : (!(decide (y = y) || decide (y = b))) = false := by simp
      rw [hcond]
      dsimp [List.length]
      have h1 := length_filter_not_pair_of_one_mem y b ys hys_nd hy_nmem hb_ys
      omega
    · by_cases hyb : y = b
      · subst hyb
        have ha_ys : a ∈ ys := by
          rcases List.mem_cons.mp ha with rfl | hm
          · exact False.elim (hya rfl)
          · exact hm
        have hcond : (!(decide (y = a) || decide (y = y))) = false := by simp
        rw [hcond]
        dsimp [List.length]
        have h_comm : ∀ x : α, (!(decide (x = a) || decide (x = y))) = (!(decide (x = y) || decide (x = a))) := by
          intro x; simp [Bool.or_comm]
        have hfeq : ys.filter (fun x => !(decide (x = a) || decide (x = y))) =
            ys.filter (fun x => !(decide (x = y) || decide (x = a))) := by
          clear hnd hys_nd hy_nmem ha hb ha_ys hcond hya
          induction ys with
          | nil => rfl
          | cons u us ihu =>
            dsimp [List.filter]
            rw [h_comm u, ihu]
        rw [hfeq]
        have h1 := length_filter_not_pair_of_one_mem y a ys hys_nd hy_nmem ha_ys
        omega
      · have ha_ys : a ∈ ys := by
          rcases List.mem_cons.mp ha with rfl | hm
          · exact False.elim (hya rfl)
          · exact hm
        have hb_ys : b ∈ ys := by
          rcases List.mem_cons.mp hb with rfl | hm
          · exact False.elim (hyb rfl)
          · exact hm
        have hcond : (!(decide (y = a) || decide (y = b))) = true := by simp [hya, hyb]
        rw [hcond]
        dsimp [List.length]
        have ih := length_filter_ne_two_of_nodup a b hab ys hys_nd ha_ys hb_ys
        omega

private theorem k5_nodup_filter {α : Type} (p : α → Bool) :
    ∀ {l : List α}, l.Nodup → (l.filter p).Nodup
  | [], _ => List.nodup_nil
  | x :: xs, hnd => by
    rcases List.nodup_cons.mp hnd with ⟨hx_nmem, hxs_nd⟩
    have ih := k5_nodup_filter p hxs_nd
    dsimp [List.filter]
    cases p x
    · exact ih
    · refine List.nodup_cons.mpr ⟨?_, ih⟩
      intro hm
      exact hx_nmem (List.mem_filter.mp hm).1

private theorem countOrbits_involution_fixed_free_aux {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ x, x ∈ darts)
    {fuel : Nat} (h_fuel : darts.length ≤ fuel)
    (h_invol : ∀ x : D, p.f (p.f x) = x) (h_free : ∀ x : D, p.f x ≠ x) :
    ∀ n (l : List D), l.length ≤ n → l.Nodup → (∀ x ∈ l, p.f x ∈ l) →
      2 * countOrbits p fuel l = l.length
  | 0, [], _, _, _ => by simp [countOrbits, countOrbitsAux]
  | 0, _ :: _, hlen, _, _ => by simp at hlen
  | n + 1, [], _, _, _ => by simp [countOrbits, countOrbitsAux]
  | n + 1, a :: as, hlen, hnd, hl_closed => by
    have hcl : orbitClosesWithin p a a fuel :=
      orbitClosesWithin_mono p a a (orbitClosesWithin_of_complete p darts h_comp a) h_fuel
    rw [countOrbits_eq_one_add_filter_of_mem p fuel (a :: as) a List.mem_cons_self hcl]
    let g := getOrbit p fuel a
    have h_g_eq : ∀ x, x ∈ g ↔ x = a ∨ x = p.f a := by
      intro x
      rw [← sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel a x]
      constructor
      · rintro ⟨k, hk⟩
        subst hk
        induction k with
        | zero => exact Or.inl rfl
        | succ k ihk =>
          rw [Perm.iter_succ]
          rcases ihk with h0 | h1
          · exact Or.inr (congrArg p.f h0)
          · exact Or.inl (by rw [h1, h_invol a])
      · intro h
        rcases h with hxa | hxb
        · rw [hxa]; exact sameOrbit_refl p a
        · rw [hxb]; exact sameOrbit_step p rfl
    have h_flt_all : ∀ xs : List D,
        xs.filter (fun x => !(@List.contains D (@instBEqOfDecidableEq D inferInstance) g x)) =
          xs.filter (fun x => !(decide (x = a) || decide (x = p.f a))) := by
      intro xs
      induction xs with
      | nil => rfl
      | cons y ys ih =>
        dsimp [List.filter]
        have hbool : (@List.contains D (@instBEqOfDecidableEq D inferInstance) g y) =
            (decide (y = a) || decide (y = p.f a)) := by
          cases hc : (@List.contains D (@instBEqOfDecidableEq D inferInstance) g y) with
          | true =>
            have hmem := (contains_decEq_eq_true_iff g y).mp hc
            rcases (h_g_eq y).mp hmem with rfl | rfl <;> simp
          | false =>
            have hnmem := (contains_decEq_eq_false_iff g y).mp hc
            have hnab : ¬ (y = a ∨ y = p.f a) := fun h => hnmem ((h_g_eq y).mpr h)
            have hna : y ≠ a := fun h => hnab (Or.inl h)
            have hnb : y ≠ p.f a := fun h => hnab (Or.inr h)
            simp [hna, hnb]
        rw [hbool]
        cases (decide (y = a) || decide (y = p.f a)) with
        | true => simp only [Bool.not_true]; exact ih
        | false => simp only [Bool.not_false]; exact congrArg (y :: ·) ih
    have h_flt_eq := h_flt_all (a :: as)
    have h_len2 : ((a :: as).filter (fun x => !(decide (x = a) || decide (x = p.f a)))).length + 2 = (a :: as).length :=
      length_filter_ne_two_of_nodup a (p.f a) (h_free a).symm (a :: as) hnd
        List.mem_cons_self (hl_closed a List.mem_cons_self)
    rw [h_flt_eq]
    have h_rest_le : ((a :: as).filter (fun x => !(decide (x = a) || decide (x = p.f a)))).length ≤ n := by
      dsimp [List.length] at hlen
      have h_alen : (a :: as).length = as.length + 1 := rfl
      omega
    have h_rest_nd : ((a :: as).filter (fun x => !(decide (x = a) || decide (x = p.f a)))).Nodup :=
      k5_nodup_filter _ hnd
    have h_rest_closed : ∀ x ∈ ((a :: as).filter (fun x => !(decide (x = a) || decide (x = p.f a)))),
        p.f x ∈ ((a :: as).filter (fun x => !(decide (x = a) || decide (x = p.f a)))) := by
      intro x hx
      rcases List.mem_filter.mp hx with ⟨hx1, hx2⟩
      refine List.mem_filter.mpr ⟨hl_closed x hx1, ?_⟩
      have hx_ne_a : x ≠ a := by
        intro h; subst h; simp at hx2
      have hx_ne_pa : x ≠ p.f a := by
        intro h; subst h; simp at hx2
      have hpx_ne_a : p.f x ≠ a := fun h => hx_ne_pa (by rw [← h, h_invol x])
      have hpx_ne_pa : p.f x ≠ p.f a := fun h => hx_ne_a (perm_f_inj p h)
      simp [hpx_ne_a, hpx_ne_pa]
    have ih := countOrbits_involution_fixed_free_aux p darts h_comp h_fuel h_invol h_free n
      ((a :: as).filter (fun x => !(decide (x = a) || decide (x = p.f a)))) h_rest_le h_rest_nd h_rest_closed
    omega

theorem countOrbits_involution_fixed_free {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (hnd : darts.Nodup) (h_comp : ∀ x, x ∈ darts)
    {fuel : Nat} (h_fuel : darts.length ≤ fuel)
    (h_invol : ∀ x : D, p.f (p.f x) = x) (h_free : ∀ x : D, p.f x ≠ x) :
    2 * countOrbits p fuel darts = darts.length :=
  countOrbits_involution_fixed_free_aux p darts h_comp h_fuel h_invol h_free darts.length darts
    (Nat.le_refl _) hnd (fun x _ => h_comp (p.f x))

private theorem countOrbits_singleton_le_one {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ x, x ∈ darts) {fuel : Nat} (h_fuel : darts.length ≤ fuel)
    (r : D) (l : List D) (h_sub : ∀ x ∈ l, SameOrbit p r x) :
    countOrbits p fuel l ≤ 1 := by
  cases l with
  | nil => simp [countOrbits, countOrbitsAux]
  | cons a as =>
    have hcl : orbitClosesWithin p a a fuel :=
      orbitClosesWithin_mono p a a (orbitClosesWithin_of_complete p darts h_comp a) h_fuel
    rw [countOrbits_eq_one_add_filter_of_mem p fuel (a :: as) a List.mem_cons_self hcl]
    have h_empty : (a :: as).filter (fun x => !(@List.contains D (@instBEqOfDecidableEq D inferInstance) (getOrbit p fuel a) x)) = [] := by
      apply List.eq_nil_iff_forall_not_mem.mpr
      intro x hx
      rcases List.mem_filter.mp hx with ⟨hx1, hx2⟩
      have h_ax : SameOrbit p a x :=
        sameOrbit_trans p (sameOrbit_symm_of_complete p darts h_comp (h_sub a List.mem_cons_self)) (h_sub x hx1)
      have hmem : x ∈ getOrbit p fuel a := (sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel a x).mp h_ax
      have ht := (contains_decEq_eq_true_iff (getOrbit p fuel a) x).mpr hmem
      change (!(@List.contains D (@instBEqOfDecidableEq D inferInstance) (getOrbit p fuel a) x)) = true at hx2
      rw [ht] at hx2; cases hx2
    rw [h_empty]
    simp [countOrbits, countOrbitsAux]

theorem countOrbits_le_of_cover {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ x, x ∈ darts) {fuel : Nat} (h_fuel : darts.length ≤ fuel) :
    ∀ (reps l : List D), (∀ x ∈ l, ∃ r ∈ reps, SameOrbit p r x) →
      countOrbits p fuel l ≤ reps.length
  | [], [], _ => by simp [countOrbits, countOrbitsAux]
  | [], a :: _, hcov => by
    rcases hcov a List.mem_cons_self with ⟨r, hr, _⟩
    cases hr
  | r :: rs, l, hcov => by
    let S : D → Bool := fun x => (@List.contains D (@instBEqOfDecidableEq D inferInstance) (getOrbit p fuel r) x)
    have hS : ∀ x : D, S (p.f x) = S x := by
      intro x
      dsimp [S]
      cases h1 : (@List.contains D (@instBEqOfDecidableEq D inferInstance) (getOrbit p fuel r) (p.f x)) with
      | true =>
        have hm := (contains_decEq_eq_true_iff _ _).mp h1
        have hso : SameOrbit p r (p.f x) := (sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel r (p.f x)).mpr hm
        exact (contains_decEq_eq_true_iff _ _).mpr ((sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel r x).mp
          (sameOrbit_trans p hso (sameOrbit_symm_of_complete p darts h_comp (sameOrbit_step p rfl)))) |>.symm
      | false =>
        have hnm := (contains_decEq_eq_false_iff _ _).mp h1
        symm
        apply (contains_decEq_eq_false_iff _ _).mpr
        intro hm
        have hso := (sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel r x).mpr hm
        exact hnm ((sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel r (p.f x)).mp
          (sameOrbit_trans p hso (sameOrbit_step p rfl)))
    rw [countOrbits_partition_of_closed p fuel l S hS]
    have h1 : countOrbits p fuel (l.filter S) ≤ 1 := by
      apply countOrbits_singleton_le_one p darts h_comp h_fuel r
      intro x hx
      have hsx := (List.mem_filter.mp hx).2
      dsimp [S] at hsx
      exact (sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel r x).mpr
        ((contains_decEq_eq_true_iff (getOrbit p fuel r) x).mp hsx)
    have h2 : countOrbits p fuel (l.filter (fun x => !S x)) ≤ rs.length := by
      apply countOrbits_le_of_cover p darts h_comp h_fuel rs
      intro x hx
      rcases List.mem_filter.mp hx with ⟨hx1, hx2⟩
      rcases hcov x hx1 with ⟨r', hr', hso⟩
      rcases List.mem_cons.mp hr' with rfl | hr_tail
      · have hm : x ∈ getOrbit p fuel r' := (sameOrbit_iff_mem_getOrbit p darts h_comp h_fuel r' x).mp hso
        have ht := (contains_decEq_eq_true_iff (getOrbit p fuel r') x).mpr hm
        dsimp [S] at hx2
        rw [ht] at hx2; cases hx2
      · exact ⟨r', hr_tail, hso⟩
    dsimp [List.length]
    omega

private theorem k5_mem_erase_of_ne {α : Type} [DecidableEq α] {a x : α} :
    ∀ {l : List α}, x ≠ a → x ∈ l → x ∈ l.erase a
  | [], _, hx => by cases hx
  | y :: ys, hxa, hx => by
    dsimp [List.erase]
    by_cases hy : y = a
    · subst hy
      have hbeq : (@instBEqOfDecidableEq α inferInstance).beq y y = true := decide_eq_true rfl
      rw [hbeq]
      rcases List.mem_cons.mp hx with rfl | hmem
      · exact False.elim (hxa rfl)
      · exact hmem
    · have hbeq : (@instBEqOfDecidableEq α inferInstance).beq y a = false := decide_eq_false hy
      rw [hbeq]
      rcases List.mem_cons.mp hx with rfl | hmem
      · exact List.mem_cons_self
      · exact List.mem_cons_of_mem y (k5_mem_erase_of_ne hxa hmem)

private theorem k5_length_erase_of_mem {α : Type} [DecidableEq α] {a : α} :
    ∀ {l : List α}, a ∈ l → (l.erase a).length + 1 = l.length
  | [], ha => by cases ha
  | y :: ys, ha => by
    dsimp [List.erase]
    by_cases hy : y = a
    · subst hy
      have hbeq : (@instBEqOfDecidableEq α inferInstance).beq y y = true := decide_eq_true rfl
      rw [hbeq]
    · have hbeq : (@instBEqOfDecidableEq α inferInstance).beq y a = false := decide_eq_false hy
      rw [hbeq]
      rcases List.mem_cons.mp ha with rfl | hmem
      · exact False.elim (hy rfl)
      · have ih := k5_length_erase_of_mem hmem
        dsimp [List.length]
        omega

private theorem k5_nodup_length_le_of_subset {α : Type} [DecidableEq α] :
    ∀ (l1 l2 : List α), l1.Nodup → (∀ x ∈ l1, x ∈ l2) → l1.length ≤ l2.length
  | [], _, _, _ => Nat.zero_le _
  | a :: as, l2, hnd, hsub => by
    rcases List.nodup_cons.mp hnd with ⟨ha_nmem, has_nd⟩
    have ha2 : a ∈ l2 := hsub a List.mem_cons_self
    have hsub_erase : ∀ x ∈ as, x ∈ l2.erase a := fun x hx =>
      k5_mem_erase_of_ne (fun h => ha_nmem (h ▸ hx)) (hsub x (List.mem_cons_of_mem a hx))
    have ih := k5_nodup_length_le_of_subset as (l2.erase a) has_nd hsub_erase
    have hlen := k5_length_erase_of_mem ha2
    dsimp [List.length]
    omega

end K5OrbitHelpers

section SurgeryOrbits

theorem sameOrbit_bypass_iff {D : Type} [DecidableEq D] (p : Perm D) (a u w : D)
    (hu : u ≠ a) (hw : w ≠ a) :
    SameOrbit (bypass p a) u w ↔ SameOrbit p u w := by
  constructor
  · rintro ⟨k, hk⟩
    subst hk
    clear hw
    induction k generalizing u with
    | zero => exact sameOrbit_refl p u
    | succ k ih =>
      rw [perm_iter_shift (bypass p a) k u]
      have h_step : (bypass p a).f u ≠ a ∧ SameOrbit p u ((bypass p a).f u) := by
        rw [bypass_eq_swapCompLeft]
        dsimp [swapCompLeft]
        by_cases hpu : p.f u = a
        · have hpa_ne : p.f a ≠ a := fun h => hu (perm_f_inj p (hpu.trans h.symm))
          rw [hpu, swapFun_left]
          refine ⟨hpa_ne, ?_⟩
          exact sameOrbit_trans p (sameOrbit_step p hpu) (sameOrbit_step p rfl)
        · by_cases hpu_pa : p.f u = p.f a
          · exact False.elim (hu (perm_f_inj p hpu_pa))
          · rw [swapFun_of_ne hpu hpu_pa]
            exact ⟨hpu, sameOrbit_step p rfl⟩
      exact sameOrbit_trans p h_step.2 (ih ((bypass p a).f u) h_step.1)
  · rintro ⟨k, hk⟩
    have h_strong : ∀ m : Nat, ∀ z : D, z ≠ a → Perm.iter p m z = w →
        SameOrbit (bypass p a) z w := by
      intro m
      induction m using Nat.strongRecOn with
      | _ m ih =>
        intro z hz hm
        cases m with
        | zero =>
          dsimp [Perm.iter] at hm
          subst hm
          exact sameOrbit_refl (bypass p a) z
        | succ m1 =>
          rw [perm_iter_shift p m1 z] at hm
          by_cases hpz : p.f z = a
          · cases m1 with
            | zero =>
              dsimp [Perm.iter] at hm
              exact False.elim (hw (hm.symm.trans hpz))
            | succ m2 =>
              rw [perm_iter_shift p m2 (p.f z), hpz] at hm
              have hpa_ne : p.f a ≠ a := fun h => hz (perm_f_inj p (hpz.trans h.symm))
              have h_reach := ih m2 (by omega) (p.f a) hpa_ne hm
              have h_step : (bypass p a).f z = p.f a := by
                rw [bypass_eq_swapCompLeft]
                dsimp [swapCompLeft]
                rw [hpz, swapFun_left]
              exact sameOrbit_trans (bypass p a) (sameOrbit_step (bypass p a) h_step) h_reach
          · have h_reach := ih m1 (by omega) (p.f z) hpz hm
            have h_step : (bypass p a).f z = p.f z := by
              rw [bypass_eq_swapCompLeft]
              dsimp [swapCompLeft]
              have hpz_pa : p.f z ≠ p.f a := fun h => hz (perm_f_inj p h)
              exact swapFun_of_ne hpz hpz_pa
            exact sameOrbit_trans (bypass p a) (sameOrbit_step (bypass p a) h_step) h_reach
    exact h_strong k u hu hk

private theorem iter_restrictPerm_val {D : Type} (p : Perm D) (removed : List D)
    (h_inv : ∀ d, d ∈ removed ↔ p.f d ∈ removed) :
    ∀ (k : Nat) (x : { d : D // ¬ d ∈ removed }),
      (Perm.iter (restrictPerm p removed h_inv) k x).val = Perm.iter p k x.val
  | 0, _ => rfl
  | k + 1, x => by
    rw [Perm.iter_succ, Perm.iter_succ, ← iter_restrictPerm_val p removed h_inv k x]
    rfl

theorem sameOrbit_restrictPerm_iff {D : Type} (p : Perm D) (removed : List D)
    (h_inv : ∀ d, d ∈ removed ↔ p.f d ∈ removed)
    (u w : { d : D // ¬ d ∈ removed }) :
    SameOrbit (restrictPerm p removed h_inv) u w ↔ SameOrbit p u.val w.val := by
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    rw [← iter_restrictPerm_val p removed h_inv k u, hk]
  · rintro ⟨k, hk⟩
    refine ⟨k, Subtype.ext ?_⟩
    rw [iter_restrictPerm_val p removed h_inv k u, hk]

private theorem ne_of_not_mem_pair {α : Type} {x a b : α} (h : ¬ x ∈ [a, b]) : x ≠ a ∧ x ≠ b :=
  ⟨fun hxa => h (by rw [hxa]; exact List.mem_cons_self),
   fun hxb => h (by rw [hxb]; exact List.mem_cons_of_mem a List.mem_cons_self)⟩

private theorem bypass_fix_left {D : Type} [DecidableEq D] (p : Perm D) (a : D) :
    (bypass p a).f a = a := by
  rw [bypass_eq_swapCompLeft]
  dsimp [swapCompLeft]
  exact swapFun_right a (p.f a)

private theorem bypass_pair_fix_left {D : Type} [DecidableEq D] (p : Perm D) (a b : D) :
    (bypass (bypass p a) b).f a = a := by
  by_cases hab : a = b
  · subst hab
    exact bypass_fix_left (bypass p a) a
  · rw [bypass_eq_swapCompLeft]
    dsimp [swapCompLeft]
    rw [bypass_fix_left p a]
    have hne : (bypass p a).f b ≠ a := by
      intro heq
      exact hab (perm_f_inj (bypass p a) (heq.trans (bypass_fix_left p a).symm).symm)
    exact swapFun_of_ne hab hne.symm

private theorem bypass_mem_pair {D : Type} [DecidableEq D] (p : Perm D) (a b : D) :
    ∀ z : D, z ∈ [a, b] ↔ (bypass (bypass p a) b).f z ∈ [a, b] := by
  have hfa : (bypass (bypass p a) b).f a = a := bypass_pair_fix_left p a b
  have hfb : (bypass (bypass p a) b).f b = b := bypass_fix_left (bypass p a) b
  intro z
  constructor
  · intro hz
    rcases List.mem_cons.mp hz with rfl | hz2
    · rw [hfa]; exact List.mem_cons_self
    · have hzb : z = b := by simpa using hz2
      subst hzb
      rw [hfb]
      exact List.mem_cons_of_mem a List.mem_cons_self
  · intro hz
    by_cases hza : z = a
    · subst hza; exact List.mem_cons_self
    · by_cases hzb : z = b
      · subst hzb; exact List.mem_cons_of_mem a List.mem_cons_self
      · rcases List.mem_cons.mp hz with heq | hz2
        · exact False.elim (hza (perm_f_inj _ (heq.trans hfa.symm)))
        · have heq : (bypass (bypass p a) b).f z = b := by simpa using hz2
          exact False.elim (hzb (perm_f_inj _ (heq.trans hfb.symm)))

theorem deleteEdgeSubtype_edge_val (H : Hypermap) [DecidableEq H.Dart] (d : H.Dart)
    (x : (H.deleteEdgeSubtype d).Dart) :
    ((H.deleteEdgeSubtype d).edge.f x).val = H.edge.f x.val := by
  rcases ne_of_not_mem_pair x.property with ⟨hx_ne_d, hx_ne_b⟩
  have hex_ne_d : H.edge.f x.val ≠ d := fun heq => hx_ne_b (by
    calc
      x.val = H.edge.f (H.edge.f x.val) := (H.edge_involution _).symm
      _ = H.edge.f d := congrArg H.edge.f heq)
  have hex_ne_b : H.edge.f x.val ≠ H.edge.f d := fun heq => hx_ne_d (perm_f_inj H.edge heq)
  change swapFun d (H.edge.f d) (H.edge.f x.val) = H.edge.f x.val
  exact swapFun_of_ne hex_ne_d hex_ne_b

theorem deleteEdgeSubtype_node_sameOrbit_iff (H : Hypermap) [DecidableEq H.Dart] (d : H.Dart)
    (u w : (H.deleteEdgeSubtype d).Dart) :
    SameOrbit (H.deleteEdgeSubtype d).node u w ↔ SameOrbit H.node u.val w.val := by
  rcases ne_of_not_mem_pair u.property with ⟨hu_ne_d, hu_ne_b⟩
  rcases ne_of_not_mem_pair w.property with ⟨hw_ne_d, hw_ne_b⟩
  have h1 : SameOrbit (H.deleteEdgeSubtype d).node u w ↔
      SameOrbit (bypass (bypass H.node d) (H.edge.f d)) u.val w.val :=
    sameOrbit_restrictPerm_iff (bypass (bypass H.node d) (H.edge.f d)) [d, H.edge.f d]
      (bypass_mem_pair H.node d (H.edge.f d)) u w
  rw [h1]
  rw [sameOrbit_bypass_iff (bypass H.node d) (H.edge.f d) u.val w.val hu_ne_b hw_ne_b]
  exact sameOrbit_bypass_iff H.node d u.val w.val hu_ne_d hw_ne_d

/-- Subtype edge contraction defined via duality from `deleteEdgeSubtype`. -/
def contractEdgeSubtype (H : Hypermap) [DecidableEq H.Dart] (d : H.Dart) : Hypermap :=
  (H.dual.deleteEdgeSubtype d).dual

instance instDecidableEqContractEdgeDart (H : Hypermap) [DecidableEq H.Dart] (d : H.Dart) :
    DecidableEq (H.contractEdgeSubtype d).Dart :=
  H.dual.instDecidableEqDeleteEdgeDart d

theorem contractEdgeSubtype_isPlanar (H : Hypermap) [DecidableEq H.Dart]
    (darts : List H.Dart) (h_nodup : darts.Nodup) (h_comp : ∀ z, z ∈ darts)
    {fuel fuel' : Nat} (h_fuel : darts.length ≤ fuel)
    (h_planar : H.isPlanar fuel darts = true)
    (d : H.Dart) (hd_ne : H.edge.f d ≠ d)
    (darts' : List (H.contractEdgeSubtype d).Dart)
    (h_nodup' : darts'.Nodup)
    (h_comp' : ∀ x : (H.contractEdgeSubtype d).Dart, x ∈ darts')
    (h_fuel' : darts'.length ≤ fuel') :
    (H.contractEdgeSubtype d).isPlanar fuel' darts' = true := by
  have h_dual_planar : H.dual.isPlanar fuel darts = true := by
    rw [isPlanar_dual_of_complete H darts h_comp h_fuel]
    exact h_planar
  have h_del : (H.dual.deleteEdgeSubtype d).isPlanar fuel' darts' = true :=
    deleteEdgeSubtype_isPlanar H.dual darts h_nodup h_comp h_fuel h_dual_planar d hd_ne
      darts' h_nodup' h_comp' h_fuel'
  dsimp only [contractEdgeSubtype]
  rw [isPlanar_dual_of_complete (H.dual.deleteEdgeSubtype d) darts' h_comp' h_fuel']
  exact h_del

theorem contractEdgeSubtype_edge_val (H : Hypermap) [DecidableEq H.Dart] (d : H.Dart)
    (x : (H.contractEdgeSubtype d).Dart) :
    ((H.contractEdgeSubtype d).edge.f x).val = H.edge.f x.val :=
  deleteEdgeSubtype_edge_val H.dual d x

theorem sameOrbit_swapCompRight_of_ne {D : Type} [DecidableEq D] (p : Perm D)
    (darts : List D) (h_comp : ∀ z, z ∈ darts)
    (d b : D) (h_not_same : ¬ SameOrbit p d b) (x y : D) :
    SameOrbit (swapCompRight p d b) x y ↔
      SameOrbit p x y ∨ ((SameOrbit p x d ∨ SameOrbit p x b) ∧ (SameOrbit p y d ∨ SameOrbit p y b)) := by
  let q := swapCompRight p d b
  have h_not_same_rev : ¬ SameOrbit p b d := fun h => h_not_same (sameOrbit_symm_of_complete p darts h_comp h)
  have hq_d_reach : ∀ k : Nat, SameOrbit q b (Perm.iter p (k + 1) d) := by
    intro k
    induction k with
    | zero => exact sameOrbit_step q (by dsimp [q, swapCompRight]; rw [swapFun_right])
    | succ k ih =>
      rw [Perm.iter_succ]
      let cur := Perm.iter p (k + 1) d
      by_cases hcd : cur = d
      · change SameOrbit q b (p.f cur)
        rw [hcd]
        exact sameOrbit_step q (by dsimp [q, swapCompRight]; rw [swapFun_right])
      · have hcb : cur ≠ b := fun h => h_not_same ⟨k + 1, h ▸ rfl⟩
        have hstep : q.f cur = p.f cur := by
          dsimp [q, swapCompRight]
          rw [swapFun_of_ne hcd hcb]
        exact sameOrbit_trans q ih (sameOrbit_step q hstep)
  have hq_b_reach : ∀ k : Nat, SameOrbit q d (Perm.iter p (k + 1) b) := by
    intro k
    induction k with
    | zero => exact sameOrbit_step q (by dsimp [q, swapCompRight]; rw [swapFun_left])
    | succ k ih =>
      rw [Perm.iter_succ]
      let cur := Perm.iter p (k + 1) b
      by_cases hcb : cur = b
      · change SameOrbit q d (p.f cur)
        rw [hcb]
        exact sameOrbit_step q (by dsimp [q, swapCompRight]; rw [swapFun_left])
      · have hcd : cur ≠ d := fun h => h_not_same_rev ⟨k + 1, h ▸ rfl⟩
        have hstep : q.f cur = p.f cur := by
          dsimp [q, swapCompRight]
          rw [swapFun_of_ne hcd hcb]
        exact sameOrbit_trans q ih (sameOrbit_step q hstep)
  have hcl_d := orbitClosesWithin_of_complete p darts h_comp d
  rcases orbitClosesWithin_imp_exists_pos_iter p darts.length d d hcl_d with ⟨md, hmd⟩
  have hcl_b := orbitClosesWithin_of_complete p darts h_comp b
  rcases orbitClosesWithin_imp_exists_pos_iter p darts.length b b hcl_b with ⟨mb, hmb⟩
  have hq_bd : SameOrbit q b d := hmd ▸ hq_d_reach md
  have hq_db : SameOrbit q d b := hmb ▸ hq_b_reach mb
  have h_all_d_to : ∀ u : D, SameOrbit p d u → SameOrbit q d u := by
    intro u ⟨k, hk⟩
    subst hk
    cases k with
    | zero => exact sameOrbit_refl q d
    | succ k => exact sameOrbit_trans q hq_db (hq_d_reach k)
  have h_all_b_to : ∀ u : D, SameOrbit p b u → SameOrbit q b u := by
    intro u ⟨k, hk⟩
    subst hk
    cases k with
    | zero => exact sameOrbit_refl q b
    | succ k => exact sameOrbit_trans q hq_bd (hq_b_reach k)
  have h_all_to_d : ∀ u : D, SameOrbit p u d → SameOrbit q u d := by
    intro u hpu
    exact sameOrbit_symm_of_complete q darts h_comp
      (h_all_d_to u (sameOrbit_symm_of_complete p darts h_comp hpu))
  have h_all_to_b : ∀ u : D, SameOrbit p u b → SameOrbit q u b := by
    intro u hpu
    exact sameOrbit_symm_of_complete q darts h_comp
      (h_all_b_to u (sameOrbit_symm_of_complete p darts h_comp hpu))
  constructor
  · rintro ⟨k, hk⟩
    subst hk
    induction k with
    | zero => exact Or.inl (sameOrbit_refl p x)
    | succ k ih =>
      rw [Perm.iter_succ]
      let z := Perm.iter q k x
      have hstep : q.f z = p.f (swapFun d b z) := rfl
      by_cases hzd : z = d
      · have hqz_eq : q.f z = p.f b := by rw [hstep, hzd, swapFun_left]
        have hpx : SameOrbit p x d ∨ SameOrbit p x b := by
          rcases ih with hpx | ⟨hxdb, _⟩
          · exact Or.inl (by change SameOrbit p x z at hpx; rw [← hzd]; exact hpx)
          · exact hxdb
        have hpy : SameOrbit p (q.f z) d ∨ SameOrbit p (q.f z) b := by
          rw [hqz_eq]
          exact Or.inr (sameOrbit_symm_of_complete p darts h_comp (sameOrbit_step p rfl))
        exact Or.inr ⟨hpx, hpy⟩
      · by_cases hzb : z = b
        · have hqz_eq : q.f z = p.f d := by rw [hstep, hzb, swapFun_right]
          have hpx : SameOrbit p x d ∨ SameOrbit p x b := by
            rcases ih with hpx | ⟨hxdb, _⟩
            · exact Or.inr (by change SameOrbit p x z at hpx; rw [← hzb]; exact hpx)
            · exact hxdb
          have hpy : SameOrbit p (q.f z) d ∨ SameOrbit p (q.f z) b := by
            rw [hqz_eq]
            exact Or.inl (sameOrbit_symm_of_complete p darts h_comp (sameOrbit_step p rfl))
          exact Or.inr ⟨hpx, hpy⟩
        · have hqf : q.f z = p.f z := by
            rw [hstep, swapFun_of_ne hzd hzb]
          rw [hqf]
          rcases ih with hpx | ⟨hxdb, hpy⟩
          · exact Or.inl (sameOrbit_trans p hpx (sameOrbit_step p rfl))
          · refine Or.inr ⟨hxdb, ?_⟩
            rcases hpy with hyd | hyb
            · exact Or.inl (sameOrbit_trans p (sameOrbit_symm_of_complete p darts h_comp (sameOrbit_step p rfl)) hyd)
            · exact Or.inr (sameOrbit_trans p (sameOrbit_symm_of_complete p darts h_comp (sameOrbit_step p rfl)) hyb)
  · rintro (hpxy | ⟨hxdb, hydb⟩)
    · by_cases hxd : SameOrbit p x d
      · exact sameOrbit_trans q (h_all_to_d x hxd)
          (h_all_d_to y (sameOrbit_trans p (sameOrbit_symm_of_complete p darts h_comp hxd) hpxy))
      · by_cases hxb : SameOrbit p x b
        · exact sameOrbit_trans q (h_all_to_b x hxb)
            (h_all_b_to y (sameOrbit_trans p (sameOrbit_symm_of_complete p darts h_comp hxb) hpxy))
        · rcases hpxy with ⟨k, hk⟩
          subst hk
          induction k with
          | zero => exact sameOrbit_refl q x
          | succ k ihk =>
            rw [Perm.iter_succ]
            let z := Perm.iter p k x
            have hzd : z ≠ d := fun h => hxd ⟨k, h⟩
            have hzb : z ≠ b := fun h => hxb ⟨k, h⟩
            have hqf : q.f z = p.f z := by
              dsimp [q, swapCompRight]; rw [swapFun_of_ne hzd hzb]
            exact sameOrbit_trans q ihk (sameOrbit_step q hqf)
    · rcases hxdb with hxd | hxb <;> rcases hydb with hyd | hyb
      · exact sameOrbit_trans q (h_all_to_d x hxd) (h_all_d_to y (sameOrbit_symm_of_complete p darts h_comp hyd))
      · exact sameOrbit_trans q (h_all_to_d x hxd) (sameOrbit_trans q hq_db (h_all_b_to y (sameOrbit_symm_of_complete p darts h_comp hyb)))
      · exact sameOrbit_trans q (h_all_to_b x hxb) (sameOrbit_trans q hq_bd (h_all_d_to y (sameOrbit_symm_of_complete p darts h_comp hyd)))
      · exact sameOrbit_trans q (h_all_to_b x hxb) (h_all_b_to y (sameOrbit_symm_of_complete p darts h_comp hyb))

theorem contractEdgeSubtype_node_sameOrbit_iff (H : Hypermap) [DecidableEq H.Dart]
    (darts : List H.Dart) (h_comp : ∀ z, z ∈ darts)
    (d : H.Dart) (h_not_same : ¬ SameOrbit H.node d (H.edge.f d))
    (u w : (H.contractEdgeSubtype d).Dart) :
    SameOrbit (H.contractEdgeSubtype d).node u w ↔
      SameOrbit H.node u.val w.val ∨
        ((SameOrbit H.node u.val d ∨ SameOrbit H.node u.val (H.edge.f d)) ∧
         (SameOrbit H.node w.val d ∨ SameOrbit H.node w.val (H.edge.f d))) := by
  let b := H.edge.f d
  rcases ne_of_not_mem_pair u.property with ⟨hu_ne_d, hu_ne_b⟩
  rcases ne_of_not_mem_pair w.property with ⟨hw_ne_d, hw_ne_b⟩
  let f3 : Perm H.Dart := bypass (bypass (swapCompRight H.node.symm d b) d) b
  have h_del_face : SameOrbit (H.dual.deleteEdgeSubtype d).face w u ↔ SameOrbit f3 w.val u.val :=
    sameOrbit_restrictPerm_iff f3 [d, b] (bypass_mem_pair (swapCompRight H.node.symm d b) d b) w u
  have h_node_eq : SameOrbit (H.contractEdgeSubtype d).node u w ↔
      SameOrbit (H.dual.deleteEdgeSubtype d).face w u := by
    change SameOrbit (H.dual.deleteEdgeSubtype d).face.symm u w ↔ _
    exact sameOrbit_symm_perm (H.dual.deleteEdgeSubtype d).face
  rw [h_node_eq, h_del_face]
  dsimp only [f3]
  rw [sameOrbit_bypass_iff _ b w.val u.val hw_ne_b hu_ne_b]
  rw [sameOrbit_bypass_iff _ d w.val u.val hw_ne_d hu_ne_d]
  have h_not_same_inv : ¬ SameOrbit H.node.symm d b := by
    intro h
    exact h_not_same (sameOrbit_symm_of_complete H.node darts h_comp ((sameOrbit_symm_perm H.node).mp h))
  rw [sameOrbit_swapCompRight_of_ne H.node.symm darts h_comp d b h_not_same_inv w.val u.val]
  have h_symm : ∀ a c : H.Dart, SameOrbit H.node.symm a c ↔ SameOrbit H.node a c := by
    intro a c
    constructor
    · intro h; exact sameOrbit_symm_of_complete H.node darts h_comp ((sameOrbit_symm_perm H.node).mp h)
    · intro h; exact (sameOrbit_symm_perm H.node).mpr (sameOrbit_symm_of_complete H.node darts h_comp h)
  rw [h_symm w.val u.val, h_symm w.val d, h_symm w.val b, h_symm u.val d, h_symm u.val b]
  constructor
  · rintro (hwu | ⟨hw, hu⟩)
    · exact Or.inl (sameOrbit_symm_of_complete H.node darts h_comp hwu)
    · exact Or.inr ⟨hu, hw⟩
  · rintro (huw | ⟨hu, hw⟩)
    · exact Or.inl (sameOrbit_symm_of_complete H.node darts h_comp huw)
    · exact Or.inr ⟨hw, hu⟩

end SurgeryOrbits

section K5SubgraphTheorem

private def pairIdxList : List (Fin 5 × Fin 5) :=
  [(0, 1), (0, 2), (0, 3), (0, 4), (1, 2), (1, 3), (1, 4), (2, 3), (2, 4), (3, 4)]

private theorem pairIdxList_len : pairIdxList.length = 10 := rfl

private theorem pairIdxList_lt : ∀ p ∈ pairIdxList, p.1 < p.2 := by
  decide

private theorem mem_pairIdxList_of_lt (i j : Fin 5) (h : i < j) : (i, j) ∈ pairIdxList := by
  have h_all : ∀ (a b : Fin 5), a < b → (a, b) ∈ pairIdxList := by decide
  exact h_all i j h

private theorem pairIdxList_nodup : pairIdxList.Nodup := by
  decide

private def k5KeepDarts (H : Hypermap) (e_dart : (i j : Fin 5) → i < j → H.Dart) : List H.Dart :=
  (pairIdxList.flatMap fun p =>
    if h : p.1 < p.2 then [e_dart p.1 p.2 h, H.edge.f (e_dart p.1 p.2 h)] else [])

private theorem mem_k5KeepDarts_iff (H : Hypermap) (e_dart : (i j : Fin 5) → i < j → H.Dart) (x : H.Dart) :
    x ∈ k5KeepDarts H e_dart ↔
      ∃ (i j : Fin 5) (h : i < j), x = e_dart i j h ∨ x = H.edge.f (e_dart i j h) := by
  dsimp [k5KeepDarts]
  rw [List.mem_flatMap]
  constructor
  · rintro ⟨p, hp_mem, hx⟩
    have hlt : p.1 < p.2 := pairIdxList_lt p hp_mem
    simp only [hlt, ↓reduceDIte] at hx
    rcases List.mem_cons.mp hx with rfl | hx2
    · exact ⟨p.1, p.2, hlt, Or.inl rfl⟩
    · have hxeq : x = H.edge.f (e_dart p.1 p.2 hlt) := by simpa using hx2
      exact ⟨p.1, p.2, hlt, Or.inr hxeq⟩
  · rintro ⟨i, j, hij, rfl | rfl⟩
    · refine ⟨(i, j), mem_pairIdxList_of_lt i j hij, ?_⟩
      simp [hij]
    · refine ⟨(i, j), mem_pairIdxList_of_lt i j hij, ?_⟩
      simp [hij]

private theorem k5KeepDarts_edge_closed (H : Hypermap) (e_dart : (i j : Fin 5) → i < j → H.Dart)
    (x : H.Dart) (hx : x ∈ k5KeepDarts H e_dart) :
    H.edge.f x ∈ k5KeepDarts H e_dart := by
  rcases (mem_k5KeepDarts_iff H e_dart x).mp hx with ⟨i, j, hij, rfl | rfl⟩
  · exact (mem_k5KeepDarts_iff H e_dart _).mpr ⟨i, j, hij, Or.inr rfl⟩
  · rw [H.edge_involution]
    exact (mem_k5KeepDarts_iff H e_dart _).mpr ⟨i, j, hij, Or.inl rfl⟩

private theorem k5KeepDarts_length (H : Hypermap)
    (e_dart : (i j : Fin 5) → i < j → H.Dart) :
    (k5KeepDarts H e_dart).length = 20 := by
  have h_pair_nodup : ∀ (l : List (Fin 5 × Fin 5)), l.Nodup → (∀ p ∈ l, p.1 < p.2) →
      (l.flatMap fun p => if h : p.1 < p.2 then [e_dart p.1 p.2 h, H.edge.f (e_dart p.1 p.2 h)] else []).length = 2 * l.length := by
    intro l hnd hlt
    induction l with
    | nil => rfl
    | cons p ps ih =>
      rcases List.nodup_cons.mp hnd with ⟨_, hps_nd⟩
      have hp : p.1 < p.2 := hlt p List.mem_cons_self
      rw [List.flatMap_cons, dif_pos hp]
      simp only [List.length_cons, List.length_append, List.length_nil]
      have ih' := ih hps_nd (fun q hq => hlt q (List.mem_cons_of_mem p hq))
      omega
  dsimp [k5KeepDarts]
  rw [h_pair_nodup pairIdxList pairIdxList_nodup pairIdxList_lt, pairIdxList_len]

/-- A planar hypermap cannot contain a `K₅` subgraph over 5 distinct node orbits and 10 edge darts. -/
theorem no_K5_subgraph_of_isPlanar (H : Hypermap) [DecidableEq H.Dart]
    (darts : List H.Dart) (h_nodup : darts.Nodup) (h_comp : ∀ d, d ∈ darts)
    (h_planar : H.isPlanar darts.length darts = true)
    (v : Fin 5 → H.Dart) (hv_distinct : ∀ i j : Fin 5, i ≠ j → ¬ SameOrbit H.node (v i) (v j))
    (e_dart : (i j : Fin 5) → i < j → H.Dart)
    (he_i : ∀ i j (h : i < j), SameOrbit H.node (e_dart i j h) (v i))
    (he_j : ∀ i j (h : i < j), SameOrbit H.node (H.edge.f (e_dart i j h)) (v j)) :
    False := by
  by_cases h_extra : ∃ x : H.Dart, ¬ x ∈ k5KeepDarts H e_dart
  · rcases h_extra with ⟨x, hx_not_keep⟩
    have hex_not_keep : ¬ H.edge.f x ∈ k5KeepDarts H e_dart := by
      intro hm
      have hxx := k5KeepDarts_edge_closed H e_dart (H.edge.f x) hm
      rw [H.edge_involution] at hxx
      exact hx_not_keep hxx
    have h_edge_free : ∀ z : H.Dart, H.edge.f z ≠ z :=
      ((eulerChar_le_two_mul_numComponents H darts h_nodup h_comp (Nat.le_refl _)).2.mp h_planar).2
    let H' := H.deleteEdgeSubtype x
    let darts' : List H'.Dart := subDarts darts [x, H.edge.f x]
    have h_nd' : darts'.Nodup := subDarts_nodup darts [x, H.edge.f x] h_nodup
    have h_comp' : ∀ z : H'.Dart, z ∈ darts' := fun z => (mem_subDarts darts [x, H.edge.f x] z).mpr (h_comp z.val)
    have h_smaller : darts'.length < darts.length :=
      exciseSubtype_strictly_smaller darts [x, H.edge.f x] ⟨x, h_comp x, List.mem_cons_self⟩
    have h_planar' : H'.isPlanar darts'.length darts' = true :=
      deleteEdgeSubtype_isPlanar H darts h_nodup h_comp (Nat.le_refl _) h_planar x (h_edge_free x)
        darts' h_nd' h_comp' (Nat.le_refl _)
    have h_keep_in_sub : ∀ z : H.Dart, z ∈ k5KeepDarts H e_dart → ¬ z ∈ [x, H.edge.f x] := by
      intro z hz hm
      rcases List.mem_cons.mp hm with rfl | hm2
      · exact hx_not_keep hz
      · have hzeq : z = H.edge.f x := by simpa using hm2
        subst hzeq; exact hex_not_keep hz
    let e_dart' : (i j : Fin 5) → i < j → H'.Dart := fun i j h =>
      ⟨e_dart i j h, h_keep_in_sub _ ((mem_k5KeepDarts_iff H e_dart _).mpr ⟨i, j, h, Or.inl rfl⟩)⟩
    let v' : Fin 5 → H'.Dart := fun i =>
      if hi : i.val < 4 then
        e_dart' i ⟨4, by omega⟩ hi
      else
        have hi4 : i = 4 := Fin.ext (by omega)
        ⟨H.edge.f (e_dart 0 4 (by decide)),
          h_keep_in_sub _ ((mem_k5KeepDarts_iff H e_dart _).mpr ⟨0, 4, by decide, Or.inr rfl⟩)⟩
    have hv'_val : ∀ i : Fin 5, SameOrbit H.node (v' i).val (v i) := by
      intro i
      dsimp only [v']
      split
      · rename_i hi
        exact he_i i ⟨4, by omega⟩ hi
      · rename_i hi
        have hi4 : i = 4 := Fin.ext (by omega)
        subst hi4
        exact he_j 0 4 (by decide)
    have hv'_distinct : ∀ i j : Fin 5, i ≠ j → ¬ SameOrbit H'.node (v' i) (v' j) := by
      intro i j hij hso
      rw [deleteEdgeSubtype_node_sameOrbit_iff H x (v' i) (v' j)] at hso
      have h_vi_vj : SameOrbit H.node (v i) (v j) :=
        sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp (hv'_val i))
          (sameOrbit_trans H.node hso (hv'_val j))
      exact hv_distinct i j hij h_vi_vj
    have he'_i : ∀ i j (h : i < j), SameOrbit H'.node (e_dart' i j h) (v' i) := by
      intro i j hij
      rw [deleteEdgeSubtype_node_sameOrbit_iff H x (e_dart' i j hij) (v' i)]
      exact sameOrbit_trans H.node (he_i i j hij)
        (sameOrbit_symm_of_complete H.node darts h_comp (hv'_val i))
    have he'_j : ∀ i j (h : i < j), SameOrbit H'.node (H'.edge.f (e_dart' i j h)) (v' j) := by
      intro i j hij
      rw [deleteEdgeSubtype_node_sameOrbit_iff H x _ (v' j)]
      rw [deleteEdgeSubtype_edge_val H x (e_dart' i j hij)]
      exact sameOrbit_trans H.node (he_j i j hij)
        (sameOrbit_symm_of_complete H.node darts h_comp (hv'_val j))
    exact no_K5_subgraph_of_isPlanar H' darts' h_nd' h_comp' h_planar' v' hv'_distinct e_dart' he'_i he'_j
  · have h_all_keep : ∀ z : H.Dart, z ∈ k5KeepDarts H e_dart := by
      intro z
      exact Classical.byContradiction fun h => h_extra ⟨z, h⟩
    have h_keep_sub : ∀ z ∈ k5KeepDarts H e_dart, z ∈ darts := fun z _ => h_comp z
    have h_keep_nodup : (k5KeepDarts H e_dart).Nodup := by
      have h_pair : ∀ (l : List (Fin 5 × Fin 5)), l.Nodup → (∀ p ∈ l, p.1 < p.2) →
          (l.flatMap fun p => if h : p.1 < p.2 then [e_dart p.1 p.2 h, H.edge.f (e_dart p.1 p.2 h)] else []).Nodup := by
        intro l hnd hlt
        induction l with
        | nil => exact List.nodup_nil
        | cons p ps ih =>
          rcases List.nodup_cons.mp hnd with ⟨hp_nmem, hps_nd⟩
          have hp : p.1 < p.2 := hlt p List.mem_cons_self
          dsimp [List.flatMap]
          simp only [hp, ↓reduceDIte]
          have h_edge_ne : e_dart p.1 p.2 hp ≠ H.edge.f (e_dart p.1 p.2 hp) := by
            intro heq
            have hj : SameOrbit H.node (e_dart p.1 p.2 hp) (v p.2) := by
              rw [heq]; exact he_j p.1 p.2 hp
            have hso := sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp (he_i p.1 p.2 hp)) hj
            exact hv_distinct p.1 p.2 (Fin.ne_of_lt hp) hso
          have h_nmem1 : ¬ e_dart p.1 p.2 hp ∈ ps.flatMap (fun q => if h : q.1 < q.2 then [e_dart q.1 q.2 h, H.edge.f (e_dart q.1 q.2 h)] else []) := by
            intro hm
            rcases List.mem_flatMap.mp hm with ⟨q, hq_mem, hqx⟩
            have hq : q.1 < q.2 := hlt q (List.mem_cons_of_mem p hq_mem)
            simp only [hq, ↓reduceDIte] at hqx
            rcases List.mem_cons.mp hqx with heq | hqx2
            · have hi1 : p.1 = q.1 := by
                by_cases hne : p.1 = q.1
                · exact hne
                · have hiq : SameOrbit H.node (e_dart p.1 p.2 hp) (v q.1) := by
                    rw [heq]; exact he_i q.1 q.2 hq
                  exact False.elim (hv_distinct p.1 q.1 hne
                    (sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp (he_i p.1 p.2 hp)) hiq))
              have hi2 : p.2 = q.2 := by
                by_cases hne : p.2 = q.2
                · exact hne
                · have heq2 : H.edge.f (e_dart p.1 p.2 hp) = H.edge.f (e_dart q.1 q.2 hq) := congrArg H.edge.f heq
                  have hjq : SameOrbit H.node (H.edge.f (e_dart p.1 p.2 hp)) (v q.2) := by
                    rw [heq2]; exact he_j q.1 q.2 hq
                  exact False.elim (hv_distinct p.2 q.2 hne
                    (sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp (he_j p.1 p.2 hp)) hjq))
              exact hp_nmem (Prod.ext hi1 hi2 ▸ hq_mem)
            · have heq : e_dart p.1 p.2 hp = H.edge.f (e_dart q.1 q.2 hq) := by simpa using hqx2
              have hp1q2 : p.1 = q.2 := by
                by_cases hne : p.1 = q.2
                · exact hne
                · have hjq : SameOrbit H.node (e_dart p.1 p.2 hp) (v q.2) := by
                    rw [heq]; exact he_j q.1 q.2 hq
                  exact False.elim (hv_distinct p.1 q.2 hne
                    (sameOrbit_trans H.node (sameOrbit_symm_of_complete H.node darts h_comp (he_i p.1 p.2 hp)) hjq))
              have hp2q1 : p.2 = q.1 := by
                by_cases hne : p.2 = q.1
                · exact hne
