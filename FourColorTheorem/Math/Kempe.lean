import FourColorTheorem.Math.Coloring

namespace Math

open Classical

/-- Two darts are in the same Kempe (c_a, c_b)-chain if there is a path of darts
between them where every dart has color `c_a` or `c_b`. 
We define this as an equivalence relation generated by node and edge steps
restricted to those two colors. -/
inductive KempeChain {D : Type} (H : Hypermap D) [CombinatorialMap H] (C : MapColoring H) (c_a c_b : Color) : D → D → Prop
  | refl (x : D) : KempeChain H C c_a c_b x x
  | node_step (x : D) :
      (C.color x = c_a ∨ C.color x = c_b) →
      KempeChain H C c_a c_b x (H.node x)
  | edge_step (x : D) :
      (C.color x = c_a ∨ C.color x = c_b) →
      KempeChain H C c_a c_b x (H.edge x)
  | trans (x y z : D) :
      KempeChain H C c_a c_b x y →
      KempeChain H C c_a c_b y z →
      KempeChain H C c_a c_b x z
  | symm (x y : D) :
      KempeChain H C c_a c_b x y →
      KempeChain H C c_a c_b y x

/-- A Kempe swap operation flips color `c_a` to `c_b` and `c_b` to `c_a`
for all darts that are in the same Kempe chain as a given starting dart `start`. -/
noncomputable def kempeSwap {D : Type} (H : Hypermap D) [CombinatorialMap H] (C : MapColoring H) (c_a c_b : Color) (start : D) : D → Color :=
  fun x =>
    if KempeChain H C c_a c_b start x then
      if C.color x = c_a then c_b
      else if C.color x = c_b then c_a
      else C.color x
    else
      C.color x

-- In a complete proof, we would now prove:
-- theorem kempeSwap_valid ... : MapColoring H (kempeSwap H C c_a c_b start)
-- Which asserts that the new coloring is still a valid `MapColoring`.

end Math
