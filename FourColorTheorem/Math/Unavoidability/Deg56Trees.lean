private theorem verifyTreePureRec_cond_join {deg tbl v m tT tF st lineno lev condV condM syms hs}
    {stT lev1 lineno1 cv1 cm1 syms1 stF next_l hs1 end_l hs2}
    (hstT : setLaneNat st v ((getLaneNat st v).land (condMaskNat m)) = stT)
    (hlev1 : lev.add 1 = lev1)
    (hlin1 : lineno.add 1 = lineno1)
    (hcv1 : setLaneNat (setLaneNat condV lev v) lev1 0 = cv1)
    (hcm1 : setLaneNat (setLaneNat condM lev (condMaskNat m)) lev1 0 = cm1)
    (hsy1 : (match extractCondsRec deg condV condM lev with
      | none => syms
      | some conds => { number := lineno, nolines := lev1, conds := conds } :: syms) = syms1)
    (hstF : setLaneNat st v ((getLaneNat st v).land (Nat.xor 31 (condMaskNat m))) = stF)
    (hT : verifyTreePureRec deg tbl tT stT lineno1 lev1 cv1 cm1 syms1 hs = (true, next_l, hs1))
    (hF : verifyTreePureRec deg tbl tF stF next_l lev cv1 cm1 syms1 hs1 = (true, end_l, hs2)) :
    verifyTreePureRec deg tbl (.cond v m tT tF) st lineno lev condV condM syms hs = (true, end_l, hs2) := by
  subst hstT hlev1 hlin1 hcv1 hcm1 hsy1 hstF
  rw [Math.Discharging.verifyTreePureRec_cond_eq]
  simp only [Math.Discharging.strictNat_eq]
  cases h_ext : extractCondsRec deg condV condM lev <;> simp only [h_ext] at hT hF ⊢
  · rw [hT]; exact hF
  · rw [hT]; exact hF

