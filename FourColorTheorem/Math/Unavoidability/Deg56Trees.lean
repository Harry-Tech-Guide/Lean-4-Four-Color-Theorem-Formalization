/-
Stage P.2 Data Certificates: Discharging proof trees (`deg = 5, 6`) and RSST (4.8) outflow bounds (`deg = 5, 6, 7`).
-/
import FourColorTheorem.Math.Discharging

namespace Math.Unavoidability

open Math.Discharging

def mkFastPosOutDeg (deg : Nat) (isPos : Bool) (conds : List (Nat × Nat × Nat)) : FastPosOut :=
  let forbid := forbidOfConds conds
  let keep := all31Nat ^^^ (forbid &&& all31Nat)
  let high := (List.range' 1 (5 * deg)).foldl
    (fun acc p => if (getLaneNat forbid p) != 0 then acc ||| (32 <<< (p * 6)) else acc) 0
  let add := (high >>> 1) ||| (high >>> 2) ||| (high >>> 3) ||| (high >>> 4) ||| (high >>> 5)
  let mask := keep &&& add
  { isPos := isPos, forbid := forbid, keep := keep, mask := mask, add := add, high := high }

def shiftCondsDeg (deg x : Nat) (conds : List (Nat × Nat × Nat)) : List (Nat × Nat × Nat) :=
  conds.map fun (p, lo, hi) => (shiftCartPos deg (x - 1) p, lo, hi)

def mkShiftedTableDeg (deg : Nat) : List (List FastPosOut) :=
  [] :: (List.range' 1 deg).map fun x =>
    (compiledOutletsForSpoke deg 1).map fun (b, conds) =>
      mkFastPosOutDeg deg b (shiftCondsDeg deg x conds)

def initStateDeg (deg : Nat) : Nat :=
  setLaneNat all31Nat 0 (1 <<< (deg - 5))

def stGe12Deg (deg : Nat) : Nat :=
  setLaneNat (initStateDeg deg) 1 16

def negAsPosDeg (deg : Nat) : List FastPosOut :=
  ((compiledOutletsForSpoke deg 1).filter (fun co => !co.1)).map
    (fun co => mkFastPosOutDeg deg true co.2)

