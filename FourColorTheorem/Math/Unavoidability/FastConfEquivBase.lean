/-!
# FastConf ↔ RConf Core Checker & Algebraic Extraction Lemmas

Shared decidable structural checker and algebraic unpacking lemmas used by the
block certificates (`FastConfEquivBlk0`..`FastConfEquivBlk9`) and re-exported by
`FourColorTheorem.Math.Unavoidability.FastConfEquiv`.
-/

namespace Math.Unavoidability

open Math Math.Discharging

/-- Whether `(a, b)` or `(b, a)` appears in contract edge list `ce`. -/
def isContractPair : List (Nat × Nat) → Nat → Nat → Bool
  | [], _, _ => false
  | p :: ps, a, b =>
    (Nat.beq p.1 a && Nat.beq p.2 b) || (Nat.beq p.1 b && Nat.beq p.2 a) ||
    isContractPair ps a b

/-- Equivalence relation (connected component) generated by contract edges `ce`. -/
inductive ContractReach (ce : List (Nat × Nat)) : Nat → Nat → Prop where
  | refl (u : Nat) : ContractReach ce u u
  | step {a b : Nat} : isContractPair ce a b = true → ContractReach ce a b
  | symm {a b : Nat} : ContractReach ce a b → ContractReach ce b a
  | trans {a b c : Nat} : ContractReach ce a b → ContractReach ce b c → ContractReach ce a c

namespace Internal

def listGetD (d : α) : List α → Nat → α
  | [], _ => d
  | x :: _, 0 => x
  | _ :: xs, k + 1 => listGetD d xs k

def listLastD (d : α) : List α → α
  | [] => d
  | [x] => x
  | _ :: y :: ys => listLastD d (y :: ys)

def dropN : Nat → List α → List α
  | 0, xs => xs
  | _ + 1, [] => []
  | k + 1, _ :: xs => dropN k xs

def memNat (u : Nat) : List Nat → Bool
  | [] => false
  | x :: xs => Nat.beq x u || memNat u xs

def addUnique (x : Nat) (xs : List Nat) : List Nat :=
  if memNat x xs then xs else x :: xs

def ceExpandStep (comp : List Nat) : List (Nat × Nat) → List Nat
  | [] => comp
  | p :: ps =>
    let comp' :=
      if memNat p.1 comp then addUnique p.2 comp
      else if memNat p.2 comp then addUnique p.1 comp
      else comp
    ceExpandStep comp' ps

def ceComp4 (ce : List (Nat × Nat)) (u : Nat) : List Nat :=
  ceExpandStep (ceExpandStep (ceExpandStep (ceExpandStep [u] ce) ce) ce) ce

def ceHasVertex : List (Nat × Nat) → Nat → Bool
  | [], _ => false
  | p :: ps, u => Nat.beq p.1 u || Nat.beq p.2 u || ceHasVertex ps u

def boolEq (a b : Bool) : Bool :=
  match a, b with
  | true, true => true
  | false, false => true
  | _, _ => false

def ceAllClosed (comp : List Nat) : List (Nat × Nat) → Bool
  | [] => true
  | p :: ps => boolEq (memNat p.1 comp) (memNat p.2 comp) && ceAllClosed comp ps

def allNotMem (comp : List Nat) (ceL : List (Nat × Nat)) (u : Nat) : List Nat → Bool
  | [] => true
  | v :: vs => (isContractPair ceL u v || !memNat v comp) && allNotMem comp ceL u vs

def checkCELoops (ceL : List (Nat × Nat)) : Nat → List (List Nat) → Bool
  | _, [] => true
  | u, nbrs :: rest =>
    (if ceHasVertex ceL u then
       let comp := ceComp4 ceL u
       memNat u comp && ceAllClosed comp ceL && allNotMem comp ceL u nbrs
     else true) &&
    checkCELoops ceL (u + 1) rest

def nbrMaskNodup : List Nat → Nat → Option Nat
  | [], m => some m
  | x :: xs, m =>
    if ((m >>> x) &&& 1) == 1 then none
    else nbrMaskNodup xs (m ||| (1 <<< x))

def allLtNe (n u : Nat) : List Nat → Bool
  | [] => true
  | v :: vs => v < n && v != u && allLtNe n u vs

def allLt (u : Nat) : List Nat → Bool
  | [] => true
  | v :: vs => v < u && allLt u vs

def checkAdjBitsGo (adjMat r fullMask : Nat) : Nat → List Nat → Bool
  | _, [] => true
  | iu, m :: rest =>
    (((adjMat >>> (iu * 12)) &&& fullMask) == ((m >>> r) &&& fullMask)) &&
    checkAdjBitsGo adjMat r fullMask (iu + 1) rest

def checkAdjBits (adjMat r intN : Nat) (adjMasks : List Nat) : Bool :=
  checkAdjBitsGo adjMat r ((1 <<< intN) - 1) 0 (dropN r adjMasks)

def checkCycMatch (first : Nat) : List Nat → List CycPair → Bool
  | [x], [cp] => cp.v == x + 1 && cp.w == first + 1
  | x :: y :: rest, cp :: cps =>
    cp.v == x + 1 && cp.w == y + 1 && checkCycMatch first (y :: rest) cps
  | _, _ => false

def checkSymLoop (u : Nat) (adjU_m : Nat) : Nat → List Nat → Bool
  | _, [] => true
  | v, earV_m :: rest =>
    ((((adjU_m >>> v) &&& 1) == 1) == (((earV_m >>> u) &&& 1) == 1)) &&
    checkSymLoop u adjU_m (v + 1) rest

def extractMasks : List (List Nat) → Option (List Nat)
  | [] => some []
  | xs :: rest =>
    match nbrMaskNodup xs 0, extractMasks rest with
    | some m, some ms => some (m :: ms)
    | _, _ => none

def checkVertAdjAndSym (n : Nat) :
    Nat → List (List Nat) → List (List Nat) → List Nat → List Nat → Bool
  | _, [], [], [], [] => true
  | u, nbrs :: rs, earU :: es, am :: ams, em :: ems =>
    allLtNe n u nbrs && allLt u earU &&
    ((am &&& ((1 <<< u) - 1)) == em) &&
    checkSymLoop u am (u + 1) ems &&
    checkVertAdjAndSym n (u + 1) rs es ams ems
  | _, _, _, _, _ => false

def checkCycTri (adjMasks : List Nat) (ceL : List (Nat × Nat)) (u0 : Nat) : List CycPair → Bool
  | [] => true
  | cp :: rest =>
    let v0 := cp.v - 1
    let w0 := cp.w - 1
    (((listGetD 0 adjMasks v0 >>> w0) &&& 1) == 1) &&
    (match ceL with
     | [] => true
     | _ :: _ =>
       ((if isContractPair ceL u0 v0 then 1 else 0) +
        (if isContractPair ceL u0 w0 then 1 else 0) +
        (if isContractPair ceL v0 w0 then 1 else 0) ≤ 1)) &&
    checkCycTri adjMasks ceL u0 rest

def countGe (r : Nat) : List Nat → Nat
  | [] => 0
  | x :: xs => (if r ≤ x then 1 else 0) + countGe r xs

def anyCycInt (r : Nat) : List CycPair → Bool
  | [] => false
  | cp :: rest => (r < cp.v && r < cp.w) || anyCycInt r rest

def checkIntVertsLoop (fc : FastConf) (r : Nat) (adjMasks : List Nat) (ceL : List (Nat × Nat)) :
    Nat → List (List Nat) → List IntVert → Bool
  | _, [], [] => true
  | u0, nbrs :: rs, iv :: ivs =>
    let d := nbrs.length
    iv.u == u0 + 1 && iv.d == d && 5 ≤ d && d ≤ 11 &&
    (d ≤ 8 || iv.u == fc.z0) &&
    iv.worried == (listLastD 0 nbrs + 1 ≤ r) &&
    (countGe r nbrs ≥ 2) &&
    anyCycInt r iv.cyc &&
    (match nbrs with
     | [] => false
     | f0 :: _ => checkCycMatch f0 nbrs iv.cyc) &&
    checkCycTri adjMasks ceL u0 iv.cyc &&
    checkIntVertsLoop fc r adjMasks ceL (u0 + 1) rs ivs
  | _, _, _ => false

def checkMidGePrev (r prev : Nat) : List Nat → Bool
  | [] => false
  | [x] => Nat.beq x prev
  | x :: y :: ys => decide (r ≤ x) && checkMidGePrev r prev (y :: ys)

def checkRingNbrs (r next prev : Nat) : List Nat → Bool
  | [] => false
  | x :: xs => Nat.beq x next && checkMidGePrev r prev xs

def checkRingLoop (r : Nat) : Nat → List Nat → List (List Nat) → Bool
  | u, am :: rest, nbrs :: nrest =>
    if u < r then
      let prev := (u + r - 1) % r
      let next := (u + 1) % r
      let ringMask := (1 <<< prev) ||| (1 <<< next)
      ((am &&& ((1 <<< r) - 1)) == ringMask) &&
      (nbrs.length ≥ 3) &&
      checkRingNbrs r next prev nbrs &&
      checkRingLoop r (u + 1) rest nrest
    else true
  | u, [], [] => u == r
  | _, _, _ => false

def cycContains : List CycPair → Nat → Nat → Bool
  | [], _, _ => false
  | cp :: rest, a, b => (cp.v == a && cp.w == b) || cycContains rest a b

def checkQStepsLoop (fc : FastConf) (r n : Nat) (adjMasks : List Nat) : List QStep → Bool
  | [] => true
  | qs :: rest =>
    1 ≤ qs.u && qs.u ≤ n && 1 ≤ qs.v && qs.v ≤ n && 1 ≤ qs.z && qs.z ≤ n &&
    qs.u != qs.v && qs.v != qs.z && qs.u != qs.z &&
    (((listGetD 0 adjMasks (qs.u - 1) >>> (qs.v - 1)) &&& 1) == 1) &&
    (((listGetD 0 adjMasks (qs.v - 1) >>> (qs.z - 1)) &&& 1) == 1) &&
    (((listGetD 0 adjMasks (qs.u - 1) >>> (qs.z - 1)) &&& 1) == 1) &&
    (if qs.z > r then qs.xi == 0 || qs.xi == (listGetD default fc.intVerts (qs.z - r - 1)).d else qs.xi == 0) &&
    (if r < qs.u then cycContains (listGetD default fc.intVerts (qs.u - r - 1)).cyc qs.v qs.z
     else r < qs.v && cycContains (listGetD default fc.intVerts (qs.v - r - 1)).cyc qs.z qs.u) &&
    checkQStepsLoop fc r n adjMasks rest

def checkCEEdges (r n : Nat) (adjMasks : List Nat) : List (Nat × Nat) → Bool
  | [] => true
  | p :: ps =>
    p.1 < n && p.2 < n && p.1 != p.2 &&
    (((listGetD 0 adjMasks p.1 >>> p.2) &&& 1) == 1) && !(p.1 < r && p.2 < r) &&
    checkCEEdges r n adjMasks ps

def countCEInc (u : Nat) : List (Nat × Nat) → Nat
  | [] => 0
  | p :: ps => (if p.1 == u || p.2 == u then 1 else 0) + countCEInc u ps

def checkContractRingDeg (ceL : List (Nat × Nat)) : Nat → Bool
  | 0 => true
  | k + 1 => (countCEInc k ceL ≤ 1) && checkContractRingDeg ceL k

def checkHeaderEquiv (fc : FastConf) (rc : FastReducer.RConf)
    (adjL earL : List (List Nat)) : Bool :=
  let r := rc.r
  let n := rc.n
  let intN := n - r
  fc.ring == r && fc.nverts == n && r ≤ n &&
  6 ≤ r && r ≤ 14 && 4 ≤ intN && intN ≤ 12 && n ≤ 26 &&
  adjL.length == n && earL.length == n &&
  fc.intVerts.length == intN

def checkStructureEquiv (fc : FastConf) (rc : FastReducer.RConf)
    (adjL earL : List (List Nat)) (adjMasks earMasks : List Nat) : Bool :=
  let r := rc.r
  let n := rc.n
  let intN := n - r
  let ceL := rc.contractEdges.toList
  checkVertAdjAndSym n 0 adjL earL adjMasks earMasks &&
  checkAdjBits fc.adjMat r intN adjMasks &&
  checkIntVertsLoop fc r adjMasks ceL r (dropN r adjL) fc.intVerts &&
  checkRingLoop r 0 adjMasks adjL

def checkQStepEquiv (fc : FastConf) (rc : FastReducer.RConf) (adjMasks : List Nat) : Bool :=
  let r := rc.r
  let n := rc.n
  let intN := n - r
  r < fc.z0 && fc.z0 ≤ n && r < fc.z1 && fc.z1 ≤ n && fc.z0 != fc.z1 &&
  (((listGetD 0 adjMasks (fc.z0 - 1) >>> (fc.z1 - 1)) &&& 1) == 1) &&
  (let zs := fc.z0 :: fc.z1 :: fc.qSteps.map (·.z)
   let fullInt := (1 <<< intN) - 1
   match nbrMaskNodup zs 0 with
   | some zm => ((zm >>> (r + 1)) &&& fullInt) == fullInt
   | none => false) &&
  checkQStepsLoop fc r n adjMasks fc.qSteps

def checkContractSafety (rc : FastReducer.RConf)
    (adjL : List (List Nat)) (adjMasks : List Nat) : Bool :=
  let r := rc.r
  let n := rc.n
  let ceL := rc.contractEdges.toList
  rc.contract == ceL.length && rc.contract ≤ 4 &&
  (match ceL with
   | [] => true
   | _ :: _ =>
     checkCEEdges r n adjMasks ceL &&
     checkContractRingDeg ceL r &&
     checkCELoops ceL 0 adjL)

end Internal

/-- Master decidable equivalence & safety checker between `fc : FastConf` and `rc : RConf`. -/
def checkConfEquiv (fc : FastConf) (rc : FastReducer.RConf) : Bool :=
  let adjL := rc.adj.toList.map Array.toList
  let earL := rc.earlier.toList.map Array.toList
  match Internal.extractMasks adjL, Internal.extractMasks earL with
  | some adjMasks, some earMasks =>
    Internal.checkHeaderEquiv fc rc adjL earL &&
    Internal.checkStructureEquiv fc rc adjL earL adjMasks earMasks &&
    Internal.checkQStepEquiv fc rc adjMasks &&
    Internal.checkContractSafety rc adjL adjMasks
  | _, _ => false

/-- Prefix-zipped checker allowing trailing padding entries in `fcs` when `rcs` is exhausted. -/
def checkListZipPrefix : List FastConf → List FastReducer.RConf → Bool
  | _, [] => true
  | fc :: fcs, rc :: rcs => checkConfEquiv fc rc && checkListZipPrefix fcs rcs
  | [], _ :: _ => false

namespace Internal

theorem natBeq_eq_true (a b : Nat) : Nat.beq a b = true ↔ a = b :=
  ⟨Nat.eq_of_beq_eq_true, fun h => h ▸ Nat.beq_refl a⟩

theorem natBeq_eq_false (a b : Nat) : Nat.beq a b = false ↔ a ≠ b := by
  rw [← Bool.not_eq_true, natBeq_eq_true]

theorem dropN_eq_drop {α : Type} (k : Nat) (xs : List α) : dropN k xs = xs.drop k := by
  induction k generalizing xs with
  | zero => cases xs <;> rfl
  | succ k ih =>
    cases xs with
    | nil => rfl
    | cons _ xs => simpa [dropN] using ih xs

theorem countGe_eq_countP (r : Nat) (xs : List Nat) :
    countGe r xs = xs.countP (· ≥ r) := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    dsimp [countGe]
    rw [List.countP_cons, ih]
    by_cases h : r ≤ x
    · simp [h]; omega
    · simp [h]

theorem anyCycInt_spec (r : Nat) (cps : List CycPair)
    (h : anyCycInt r cps = true) :
    ∃ cp ∈ cps, cp.v > r ∧ cp.w > r := by
  induction cps with
  | nil => cases h
  | cons cp rest ih =>
    dsimp [anyCycInt] at h
    simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h
    rcases h with ⟨hv, hw⟩ | hrest
    · exact ⟨cp, List.mem_cons_self, hv, hw⟩
    · rcases ih hrest with ⟨cp', hmem, hlt⟩
      exact ⟨cp', List.mem_cons_of_mem _ hmem, hlt⟩

theorem checkMidGePrev_spec (r prev : Nat) (xs : List Nat)
    (h : checkMidGePrev r prev xs = true) :
    xs.length ≥ 1 ∧ xs.getLast? = some prev ∧ ∀ v ∈ xs.dropLast, r ≤ v := by
  induction xs with
  | nil => cases h
  | cons x xs ih =>
    cases xs with
    | nil =>
      dsimp [checkMidGePrev] at h
      rw [natBeq_eq_true] at h
      refine ⟨by simp, by simp [h], fun v hv => by cases hv⟩
    | cons y ys =>
      dsimp [checkMidGePrev] at h
      simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨hlen, hlast, hdrop⟩ := ih h.2
      refine ⟨by simp, ?_, ?_⟩
      · rw [List.getLast?_cons_cons]; exact hlast
      · intro v hv
        rw [List.dropLast_cons_of_ne_nil (by simp)] at hv
        rcases List.mem_cons.mp hv with rfl | hmem
        · exact h.1
        · exact hdrop v hmem

theorem checkRingNbrs_spec (r next prev : Nat) (nbrs : List Nat)
    (hlen : nbrs.length ≥ 3) (h : checkRingNbrs r next prev nbrs = true) :
    nbrs.head? = some next ∧ nbrs.getLast? = some prev ∧ ∀ v ∈ (nbrs.drop 1).dropLast, r ≤ v := by
  cases nbrs with
  | nil => simp at hlen
  | cons x xs =>
    dsimp [checkRingNbrs] at h
    simp only [Bool.and_eq_true, natBeq_eq_true] at h
    rcases h with ⟨rfl, hmid⟩
    obtain ⟨_, hxlast, hxdrop⟩ := checkMidGePrev_spec r prev xs hmid
    refine ⟨rfl, ?_, hxdrop⟩
    cases xs with
    | nil => simp at hlen
    | cons y ys =>
      rw [List.getLast?_cons_cons]
      exact hxlast

theorem testBit_and_one_eq (m x : Nat) :
    (((m >>> x) &&& 1) == 1) = Nat.testBit m x := by
  simp only [Nat.testBit, Nat.and_one_is_mod]
  cases Nat.mod_two_eq_zero_or_one (m >>> x) with
  | inl h => simp [h]
  | inr h => simp [h]

theorem testBit_and_one_zero (m x : Nat) :
    (((m >>> x) &&& 1) == 0) = !Nat.testBit m x := by
  simp only [Nat.testBit, Nat.and_one_is_mod]
  cases Nat.mod_two_eq_zero_or_one (m >>> x) with
  | inl h => simp [h]
  | inr h => simp [h]

theorem testBit_one_shiftLeft (x y : Nat) :
    Nat.testBit (1 <<< x) y = decide (x = y) := by
  rw [Nat.testBit_shiftLeft]
  by_cases h : x ≤ y
  · have hb : Nat.testBit 1 (y - x) = decide (y - x = 0) := by
      cases hd : y - x with
      | zero => decide
      | succ k =>
        simp only [Nat.testBit, Nat.shiftRight_eq_div_pow]
        have hk : 1 < 2 ^ (k + 1) := by
          have : 2 ^ 1 ≤ 2 ^ (k + 1) := Nat.pow_le_pow_right (by omega) (by omega)
          omega
        simp [Nat.div_eq_of_lt hk]
    rw [decide_eq_true h, Bool.true_and, hb]
    by_cases hxy : x = y
    · subst hxy; simp
    · have hne : y - x ≠ 0 := by omega
      simp [hxy, hne]
  · rw [decide_eq_false h, Bool.false_and]
    symm; simp; omega

theorem listGetD_eq_getElem {α : Type} (d : α) (xs : List α) {i : Nat} (hi : i < xs.length) :
    listGetD d xs i = xs[i] := by
  induction xs generalizing i with
  | nil => simp at hi
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ k => exact ih (by simpa using hi)

theorem array_getD_toList {α : Type} (a : Array α) (i : Nat) (d : α) :
    (a.getD i d) = listGetD d a.toList i := by
  have h1 : ∀ (l : List α) (k : Nat), listGetD d l k = (l[k]?).getD d := by
    intro l
    induction l with
    | nil => intro k; cases k <;> rfl
    | cons x xs ih =>
      intro k
      cases k with
      | zero => rfl
      | succ k' => exact ih k'
  rw [h1]
  by_cases hi : i < a.size <;> simp [Array.getD, hi]

theorem nbrMaskNodup_spec (xs : List Nat) (m res : Nat)
    (h : nbrMaskNodup xs m = some res) :
    xs.Nodup ∧ (∀ x ∈ xs, Nat.testBit m x = false) ∧
    (∀ y, Nat.testBit res y = (Nat.testBit m y || xs.contains y)) := by
  induction xs generalizing m with
  | nil =>
    cases h
    refine ⟨List.nodup_nil, ?_, ?_⟩
    · intro _ hm; cases hm
    · intro y; simp
  | cons x xs ih =>
    dsimp [nbrMaskNodup] at h
    rw [testBit_and_one_eq] at h
    cases hbit : Nat.testBit m x with
    | true => simp [hbit] at h
    | false =>
      simp only [hbit, Bool.false_eq_true, ↓reduceIte] at h
      have h_ih := ih (m ||| (1 <<< x)) h
      rcases h_ih with ⟨hnodup, hnot, hbits⟩
      refine ⟨List.nodup_cons.mpr ⟨?_, hnodup⟩, ?_, ?_⟩
      · intro hxmem
        have h1 := hnot x hxmem
        rw [Nat.testBit_or, testBit_one_shiftLeft] at h1
        simp at h1
      · intro z hz
        rcases List.mem_cons.mp hz with rfl | hzs
        · exact hbit
        · have h1 := hnot z hzs
          rw [Nat.testBit_or] at h1
          exact (Bool.or_eq_false_iff.mp h1).1
      · intro y
        rw [hbits y, Nat.testBit_or, testBit_one_shiftLeft]
        simp only [List.contains_cons]
        by_cases hyx : y = x
        · subst hyx; simp
        · have hne2 : (y == x) = false := beq_false_of_ne hyx
          have hdec : decide (x = y) = false := decide_eq_false (Ne.symm hyx)
          simp [hne2, hdec]

theorem extractMasks_spec (xss : List (List Nat)) (ms : List Nat)
    (h : extractMasks xss = some ms) :
    ms.length = xss.length ∧
    ∀ i (hi : i < xss.length),
      (xss[i]).Nodup ∧ ∀ y, Nat.testBit (listGetD 0 ms i) y = (xss[i]).contains y := by
  induction xss generalizing ms with
  | nil =>
    cases h
    exact ⟨rfl, fun i hi => nomatch hi⟩
  | cons xs rest ih =>
    dsimp [extractMasks] at h
    cases hm : nbrMaskNodup xs 0 with
    | none => simp [hm] at h
    | some m =>
      cases hms : extractMasks rest with
      | none => simp [hm, hms] at h
      | some ms' =>
        simp [hm, hms] at h
        subst h
        have ⟨hlen, hrest⟩ := ih ms' hms
        refine ⟨by simp [hlen], fun i hi => ?_⟩
        cases i with
        | zero =>
          have ⟨hn, _, hb⟩ := nbrMaskNodup_spec xs 0 m hm
          refine ⟨hn, fun y => ?_⟩
          simpa [listGetD] using hb y
        | succ k =>
          exact hrest k (by simpa using hi)

theorem allLtNe_spec (n u : Nat) (xs : List Nat) (h : allLtNe n u xs = true) :
    ∀ v ∈ xs, v < n ∧ v ≠ u := by
  induction xs with
  | nil => intro v hv; cases hv
  | cons x xs ih =>
    dsimp [allLtNe] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne] at h
    intro v hv
    rcases List.mem_cons.mp hv with rfl | hxs
    · exact h.1
    · exact ih h.2 v hxs

theorem allLt_spec (u : Nat) (xs : List Nat) (h : allLt u xs = true) :
    ∀ v ∈ xs, v < u := by
  induction xs with
  | nil => intro v hv; cases hv
  | cons x xs ih =>
    dsimp [allLt] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    intro v hv
    rcases List.mem_cons.mp hv with rfl | hxs
    · exact h.1
    · exact ih h.2 v hxs

theorem checkSymLoop_spec (u am v0 : Nat) (ems : List Nat)
    (h : checkSymLoop u am v0 ems = true) :
    ∀ k (hk : k < ems.length), am.testBit (v0 + k) = ems[k].testBit u := by
  induction ems generalizing v0 with
  | nil => intro k hk; cases hk
  | cons em rest ih =>
    dsimp [checkSymLoop] at h
    simp only [Bool.and_eq_true, beq_iff_eq, testBit_and_one_eq] at h
    intro k hk
    cases k with
    | zero => simpa using h.1
    | succ k' =>
      have := ih (v0 + 1) h.2 k' (Nat.lt_of_succ_lt_succ hk)
      simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using this

theorem checkVertAdjAndSym_lengths (n u0 : Nat) (rs es : List (List Nat)) (ams ems : List Nat)
    (h : checkVertAdjAndSym n u0 rs es ams ems = true) :
    es.length = rs.length ∧ ams.length = rs.length ∧ ems.length = rs.length := by
  induction rs generalizing u0 es ams ems with
  | nil =>
    cases es with
    | cons _ _ => simp [checkVertAdjAndSym] at h
    | nil =>
      cases ams with
      | cons _ _ => simp [checkVertAdjAndSym] at h
      | nil =>
        cases ems with
        | cons _ _ => simp [checkVertAdjAndSym] at h
        | nil => exact ⟨rfl, rfl, rfl⟩
  | cons _ _ ih =>
    cases es with
    | nil => simp [checkVertAdjAndSym] at h
    | cons _ es =>
      cases ams with
      | nil => simp [checkVertAdjAndSym] at h
      | cons _ ams =>
        cases ems with
        | nil => simp [checkVertAdjAndSym] at h
        | cons _ ems =>
          dsimp [checkVertAdjAndSym] at h
          simp only [Bool.and_eq_true] at h
          have h_ih := ih (u0 + 1) es ams ems h.2
          simp [h_ih.1, h_ih.2.1, h_ih.2.2]

theorem checkVertAdjAndSym_spec (n u0 : Nat) (rs es : List (List Nat)) (ams ems : List Nat)
    (h_ams : ams.length = rs.length ∧
      ∀ i (hi : i < rs.length), (rs[i]).Nodup ∧ ∀ y, Nat.testBit (listGetD 0 ams i) y = (rs[i]).contains y)
    (h_ems : ems.length = es.length ∧
      ∀ i (hi : i < es.length), (es[i]).Nodup ∧ ∀ y, Nat.testBit (listGetD 0 ems i) y = (es[i]).contains y)
    (h : checkVertAdjAndSym n u0 rs es ams ems = true) :
    ∀ k (hk : k < rs.length),
      (∀ v ∈ rs[k], v < n ∧ v ≠ u0 + k) ∧
      (∀ v ∈ es[k]'(by rw [(checkVertAdjAndSym_lengths n u0 rs es ams ems h).1]; exact hk), v < u0 + k) ∧
      (∀ v < u0 + k, (rs[k]).contains v =
        (es[k]'(by rw [(checkVertAdjAndSym_lengths n u0 rs es ams ems h).1]; exact hk)).contains v) ∧
      (∀ k' (hk' : k' < rs.length), k < k' →
        (rs[k]).contains (u0 + k') =
          (es[k']'(by rw [(checkVertAdjAndSym_lengths n u0 rs es ams ems h).1]; exact hk')).contains (u0 + k)) := by
  induction rs generalizing u0 es ams ems with
  | nil => intro k hk; cases hk
  | cons nbrs rs ih =>
    cases es with
    | nil => simp [checkVertAdjAndSym] at h
    | cons earU es =>
      cases ams with
      | nil => simp [checkVertAdjAndSym] at h
      | cons am ams =>
        cases ems with
        | nil => simp [checkVertAdjAndSym] at h
        | cons em ems =>
          dsimp [checkVertAdjAndSym] at h
          simp only [Bool.and_eq_true, beq_iff_eq] at h
          have ⟨⟨⟨⟨h_ltne, h_lt⟩, h_mask⟩, h_symLoop⟩, h_rest⟩ := h
          have h_ams' : ams.length = rs.length ∧
              ∀ i (hi : i < rs.length), (rs[i]).Nodup ∧ ∀ y, Nat.testBit (listGetD 0 ams i) y = (rs[i]).contains y :=
            ⟨by simpa using h_ams.1, fun i hi => h_ams.2 (i + 1) (Nat.succ_lt_succ hi)⟩
          have h_ems' : ems.length = es.length ∧
              ∀ i (hi : i < es.length), (es[i]).Nodup ∧ ∀ y, Nat.testBit (listGetD 0 ems i) y = (es[i]).contains y :=
            ⟨by simpa using h_ems.1, fun i hi => h_ems.2 (i + 1) (Nat.succ_lt_succ hi)⟩
          have h_ih := ih (u0 + 1) es ams ems h_ams' h_ems' h_rest
          intro k hk
          cases k with
          | zero =>
            dsimp
            refine ⟨allLtNe_spec n u0 nbrs h_ltne, allLt_spec u0 earU h_lt, ?_, ?_⟩
            · intro v hv
              have hbit := congrArg (fun z => z.testBit v) h_mask
              have hvu0 : decide (v < u0) = true := decide_eq_true hv
              simp only [Nat.testBit_and, Nat.one_shiftLeft, Nat.testBit_two_pow_sub_one,
                hvu0, Bool.and_true] at hbit
              have ham0 := (h_ams.2 0 hk).2 v
              have hem0 := (h_ems.2 0 (by simp)).2 v
              change am.testBit v = nbrs.contains v at ham0
              change em.testBit v = earU.contains v at hem0
              rw [← ham0, ← hem0, hbit]
            · intro k' hk' h0k'
              cases k' with
              | zero => omega
              | succ j =>
                have hj_es : j < es.length := by
                  have hlen := (checkVertAdjAndSym_lengths n (u0 + 1) rs es ams ems h_rest).1
                  have hj_rs : j < rs.length := Nat.lt_of_succ_lt_succ hk'
                  omega
                have hj_ems : j < ems.length := by rw [h_ems'.1]; exact hj_es
                have hsym := checkSymLoop_spec u0 am (u0 + 1) ems h_symLoop j hj_ems
                have ham0 := (h_ams.2 0 hk).2 (u0 + 1 + j)
                change am.testBit (u0 + 1 + j) = nbrs.contains (u0 + 1 + j) at ham0
                have hemj := (h_ems'.2 j hj_es).2 u0
                rw [listGetD_eq_getElem 0 ems hj_ems] at hemj
                have hid : u0 + (j + 1) = u0 + 1 + j := by omega
                dsimp
                rw [hid, ← ham0, hsym, hemj]
          | succ k0 =>
            have hk0 : k0 < rs.length := Nat.lt_of_succ_lt_succ hk
            have hrec := h_ih k0 hk0
            have hid : u0 + (k0 + 1) = (u0 + 1) + k0 := by omega
            refine ⟨?_, ?_, ?_, ?_⟩
            · simpa [hid] using hrec.1
            · simpa [hid] using hrec.2.1
            · simpa [hid] using hrec.2.2.1
            · intro k' hk' hkk'
              cases k' with
              | zero => omega
              | succ k'0 =>
                have hk'0 : k'0 < rs.length := Nat.lt_of_succ_lt_succ hk'
                have hlt' : k0 < k'0 := Nat.lt_of_succ_lt_succ hkk'
                have hid' : u0 + (k'0 + 1) = (u0 + 1) + k'0 := by omega
                simpa [hid, hid'] using hrec.2.2.2 k'0 hk'0 hlt'

theorem checkAdjBitsGo_spec (adjMat r fullMask iu0 : Nat) (ms : List Nat)
    (h : checkAdjBitsGo adjMat r fullMask iu0 ms = true) :
    ∀ k (hk : k < ms.length), ∀ iv, fullMask.testBit iv = true →
      adjMat.testBit ((iu0 + k) * 12 + iv) = ms[k].testBit (r + iv) := by
  induction ms generalizing iu0 with
  | nil => intro k hk; cases hk
  | cons m rest ih =>
    dsimp [checkAdjBitsGo] at h
    simp only [Bool.and_eq_true, beq_iff_eq] at h
    intro k hk iv hiv
    cases k with
    | zero =>
      have hbit := congrArg (fun z => z.testBit iv) h.1
      simp only [Nat.testBit_and, Nat.testBit_shiftRight, hiv, Bool.and_true] at hbit
      simpa [Nat.add_assoc] using hbit
    | succ k' =>
      have := ih (iu0 + 1) h.2 k' (by simpa using hk) iv hiv
      simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using this

theorem checkAdjBits_spec (adjMat r intN : Nat) (ms : List Nat)
    (h : checkAdjBits adjMat r intN ms = true) :
    ∀ k (hk : k < (ms.drop r).length), ∀ iv < intN,
      adjMat.testBit (k * 12 + iv) = (ms.drop r)[k].testBit (r + iv) := by
  intro k hk iv hiv
  dsimp [checkAdjBits] at h
  rw [dropN_eq_drop] at h
  have hgo := checkAdjBitsGo_spec adjMat r ((1 <<< intN) - 1) 0 (ms.drop r) h k hk iv
  have hbm : ((1 <<< intN) - 1).testBit iv = true := by
    rw [Nat.one_shiftLeft, Nat.testBit_two_pow_sub_one]
    exact decide_eq_true hiv
  simpa using hgo hbm

theorem checkRingLoop_spec (r u0 : Nat) (ams : List Nat) (nss : List (List Nat))
    (hle : nss.length = ams.length)
    (h : checkRingLoop r u0 ams nss = true) :
    ∀ k (hk : k < ams.length), u0 + k < r →
      ((ams[k] &&& ((1 <<< r) - 1)) = (1 <<< ((u0 + k + r - 1) % r)) ||| (1 <<< ((u0 + k + 1) % r))) ∧
      (nss[k]'(by rw [hle]; exact hk)).length ≥ 3 ∧
      (nss[k]'(by rw [hle]; exact hk)).head? = some ((u0 + k + 1) % r) ∧
      (nss[k]'(by rw [hle]; exact hk)).getLast? = some ((u0 + k + r - 1) % r) ∧
      (∀ v ∈ ((nss[k]'(by rw [hle]; exact hk)).drop 1).dropLast, r ≤ v) := by
  induction ams generalizing u0 nss with
  | nil => intro k hk; cases hk
  | cons am rest ih =>
    cases nss with
    | nil => simp at hle
    | cons nbrs nrest =>
      intro k hk hlt
      dsimp [checkRingLoop] at h
      by_cases hu0 : u0 < r
      · rw [if_pos hu0] at h
        simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
        rcases h with ⟨⟨⟨hmask, hlen⟩, hrn⟩, hrec⟩
        cases k with
        | zero =>
          obtain ⟨hhd, hlast, hmid⟩ := checkRingNbrs_spec r ((u0 + 1) % r) ((u0 + r - 1) % r) nbrs hlen hrn
          exact ⟨hmask, hlen, by simpa using hhd, by simpa using hlast, hmid⟩
        | succ k' =>
          have hrec' := ih (u0 + 1) nrest (by simpa using hle) hrec k' (Nat.lt_of_succ_lt_succ hk) (by omega)
          simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hrec'
      · omega

theorem checkCycMatch_len (first : Nat) (nbrs : List Nat) (cps : List CycPair)
    (h : checkCycMatch first nbrs cps = true) : cps.length = nbrs.length := by
  induction nbrs generalizing cps with
  | nil => cases cps <;> contradiction
  | cons x xs ih =>
    cases xs with
    | nil =>
      cases cps with
      | nil => contradiction
      | cons cp cps' =>
        cases cps' with
        | nil => rfl
        | cons _ _ => contradiction
    | cons y rest =>
      cases cps with
      | nil => contradiction
      | cons cp cps' =>
        dsimp [checkCycMatch] at h
        simp only [Bool.and_eq_true, beq_iff_eq] at h
        simp [ih cps' h.2]

theorem checkCycMatch_get (first : Nat) (nbrs : List Nat) (cps : List CycPair)
    (h : checkCycMatch first nbrs cps = true) :
    ∀ j (hj : j < nbrs.length),
      cps[j]'(by rw [checkCycMatch_len first nbrs cps h]; exact hj) =
        CycPair.mk (nbrs[j] + 1)
          (if hj1 : j + 1 < nbrs.length then nbrs[j + 1] + 1 else first + 1) := by
  induction nbrs generalizing cps with
  | nil => intro j hj; cases hj
  | cons x xs ih =>
    cases xs with
    | nil =>
      cases cps with
      | nil => contradiction
      | cons cp cps' =>
        cases cps' with
        | nil =>
          dsimp [checkCycMatch] at h
          simp only [Bool.and_eq_true, beq_iff_eq] at h
          intro j hj
          have hj0 : j = 0 := by simp at hj; omega
          subst hj0
          rcases cp with ⟨v, w⟩
          dsimp at h ⊢
          simp [h.1, h.2]
        | cons _ _ => contradiction
    | cons y rest =>
      cases cps with
      | nil => contradiction
      | cons cp cps' =>
        dsimp [checkCycMatch] at h
        simp only [Bool.and_eq_true, beq_iff_eq] at h
        have h_ih := ih cps' h.2
        intro j hj
        cases j with
        | zero =>
          rcases cp with ⟨v, w⟩
          dsimp at h ⊢
          simp [h.1.1, h.1.2]
        | succ k =>
          have hk : k < (y :: rest).length := Nat.lt_of_succ_lt_succ hj
          have heq := h_ih k hk
          have hcps := checkCycMatch_len first (y :: rest) cps' h.2
          have heq' : cps'[k]'(by rw [hcps]; exact hk) =
              CycPair.mk ((y :: rest)[k] + 1)
                (if hj1 : k + 1 < (y :: rest).length then (y :: rest)[k + 1] + 1 else first + 1) := heq
          change cps'[k]'(by rw [hcps]; exact hk) =
            CycPair.mk ((y :: rest)[k] + 1)
              (if hj1 : k + 1 + 1 < (x :: y :: rest).length then (x :: y :: rest)[k + 1 + 1] + 1 else first + 1)
          rw [heq']
          by_cases hcond : k + 1 < (y :: rest).length
          · have hcond2 : k + 1 + 1 < (x :: y :: rest).length := Nat.succ_lt_succ hcond
            rw [dif_pos hcond, dif_pos hcond2]; rfl
          · have hcond2 : ¬ (k + 1 + 1 < (x :: y :: rest).length) := fun h' => hcond (Nat.lt_of_succ_lt_succ h')
            rw [dif_neg hcond, dif_neg hcond2]

theorem checkCycTri_spec (adjMasks : List Nat) (ceL : List (Nat × Nat)) (u0 : Nat) (cps : List CycPair)
    (h : checkCycTri adjMasks ceL u0 cps = true) :
    ∀ cp ∈ cps,
      Nat.testBit (listGetD 0 adjMasks (cp.v - 1)) (cp.w - 1) = true ∧
      ((ceL ≠ []) →
        (if isContractPair ceL u0 (cp.v - 1) then 1 else 0) +
        (if isContractPair ceL u0 (cp.w - 1) then 1 else 0) +
        (if isContractPair ceL (cp.v - 1) (cp.w - 1) then 1 else 0) ≤ 1) := by
  induction cps with
  | nil => intro cp hcp; cases hcp
  | cons cp rest ih =>
    dsimp [checkCycTri] at h
    simp only [Bool.and_eq_true, testBit_and_one_eq] at h
    intro x hx
    rcases List.mem_cons.mp hx with rfl | hxrest
    · refine ⟨h.1.1, fun hne => ?_⟩
      cases ceL with
      | nil => exact absurd rfl hne
      | cons _ _ =>
        have htri := h.1.2
        dsimp at htri
        exact decide_eq_true_eq.mp htri
    · exact ih h.2 x hxrest

theorem checkIntVertsLoop_len (fc : FastConf) (r : Nat) (adjMasks : List Nat) (ceL : List (Nat × Nat))
    (u0 : Nat) (rs : List (List Nat)) (ivs : List IntVert)
    (h : checkIntVertsLoop fc r adjMasks ceL u0 rs ivs = true) :
    ivs.length = rs.length := by
  induction rs generalizing u0 ivs with
  | nil => cases ivs with | nil => rfl | cons _ _ => simp [checkIntVertsLoop] at h
  | cons _ _ ih =>
    cases ivs with
    | nil => simp [checkIntVertsLoop] at h
    | cons _ _ =>
      dsimp [checkIntVertsLoop] at h
      simp only [Bool.and_eq_true] at h
      simp [ih _ _ h.2]

theorem checkIntVertsLoop_spec (fc : FastConf) (r : Nat) (adjMasks : List Nat) (ceL : List (Nat × Nat))
    (u0 : Nat) (rs : List (List Nat)) (ivs : List IntVert)
    (h : checkIntVertsLoop fc r adjMasks ceL u0 rs ivs = true) :
    ∀ k (hk : k < rs.length),
      let iv := ivs[k]'(by rw [checkIntVertsLoop_len fc r adjMasks ceL u0 rs ivs h]; exact hk)
      let nbrs := rs[k]
      iv.u = u0 + k + 1 ∧
      iv.d = nbrs.length ∧
      5 ≤ nbrs.length ∧ nbrs.length ≤ 11 ∧
      (nbrs.length ≤ 8 ∨ iv.u = fc.z0) ∧
      nbrs.countP (· ≥ r) ≥ 2 ∧
      (∃ cp ∈ iv.cyc, cp.v > r ∧ cp.w > r) ∧
      (∃ f0 rest, nbrs = f0 :: rest ∧ checkCycMatch f0 nbrs iv.cyc = true) ∧
      checkCycTri adjMasks ceL (u0 + k) iv.cyc = true := by
  induction rs generalizing u0 ivs with
  | nil => intro k hk; cases hk
  | cons nbrs rs ih =>
    cases ivs with
    | nil => simp [checkIntVertsLoop] at h
    | cons iv ivs =>
      dsimp [checkIntVertsLoop] at h
      simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at h
      rcases h with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hu, hd⟩, hd5⟩, hd11⟩, hd8⟩, _hwor⟩, hcnt⟩, hcyc_int⟩, hm⟩, htri⟩, hrest⟩
      have h_ih := ih (u0 + 1) ivs hrest
      intro k hk
      cases k with
      | zero =>
        rw [countGe_eq_countP] at hcnt
        have hcp := anyCycInt_spec r iv.cyc hcyc_int
        cases nbrs with
        | nil => simp at hd5
        | cons f0 rest =>
          exact ⟨hu, hd, hd5, hd11, hd8, hcnt, hcp, ⟨f0, rest, rfl, hm⟩, htri⟩
      | succ k' =>
        have hk' : k' < rs.length := Nat.lt_of_succ_lt_succ hk
        have hrec := h_ih k' hk'
        simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hrec

theorem checkQStepsLoop_spec (fc : FastConf) (r n : Nat) (adjMasks : List Nat) (qss : List QStep)
    (h : checkQStepsLoop fc r n adjMasks qss = true) :
    ∀ qs ∈ qss,
      1 ≤ qs.u ∧ qs.u ≤ n ∧ 1 ≤ qs.v ∧ qs.v ≤ n ∧ 1 ≤ qs.z ∧ qs.z ≤ n ∧
      qs.u ≠ qs.v ∧ qs.v ≠ qs.z ∧ qs.u ≠ qs.z ∧
      Nat.testBit (listGetD 0 adjMasks (qs.u - 1)) (qs.v - 1) = true ∧
      Nat.testBit (listGetD 0 adjMasks (qs.v - 1)) (qs.z - 1) = true ∧
      Nat.testBit (listGetD 0 adjMasks (qs.u - 1)) (qs.z - 1) = true := by
  induction qss with
  | nil => intro qs hqs; cases hqs
  | cons qs rest ih =>
    dsimp [checkQStepsLoop] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, testBit_and_one_eq] at h
    rcases h with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hu1, hun⟩, hv1⟩, hvn⟩, hz1⟩, hzn⟩, huv⟩, hvz⟩, huz⟩, e1⟩, e2⟩, e3⟩, _hxi⟩, _hcyc⟩, hrest⟩
    intro q hq
    rcases List.mem_cons.mp hq with rfl | hrest_mem
    · exact ⟨hu1, hun, hv1, hvn, hz1, hzn, huv, hvz, huz, e1, e2, e3⟩
    · exact ih hrest q hrest_mem

theorem isContractPair_mem (ce : List (Nat × Nat)) (a b : Nat)
    (h : isContractPair ce a b = true) :
    ∃ p ∈ ce, (p.1 = a ∧ p.2 = b) ∨ (p.1 = b ∧ p.2 = a) := by
  induction ce with
  | nil => cases h
  | cons p ps ih =>
    dsimp [isContractPair] at h
    simp only [Bool.or_eq_true, Bool.and_eq_true, natBeq_eq_true] at h
    rcases h with (hab | hba) | hps
    · exact ⟨p, List.mem_cons_self, Or.inl hab⟩
    · exact ⟨p, List.mem_cons_self, Or.inr hba⟩
    · rcases ih hps with ⟨q, hq, hcase⟩
      exact ⟨q, List.mem_cons_of_mem _ hq, hcase⟩

theorem contractReach_nil {a b : Nat} (h : ContractReach [] a b) : a = b := by
  induction h with
  | refl => rfl
  | step h => cases h
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

theorem ceHasVertex_false (ce : List (Nat × Nat)) (u : Nat)
    (h : ceHasVertex ce u = false) :
    ∀ p ∈ ce, p.1 ≠ u ∧ p.2 ≠ u := by
  induction ce with
  | nil => intro p hp; cases hp
  | cons p ps ih =>
    dsimp [ceHasVertex] at h
    simp only [Bool.or_eq_false_iff, natBeq_eq_false] at h
    intro q hq
    rcases List.mem_cons.mp hq with rfl | hqps
    · exact h.1
    · exact ih h.2 q hqps

theorem contractReach_no_vertex (ce : List (Nat × Nat)) (u : Nat)
    (hno : ∀ p ∈ ce, p.1 ≠ u ∧ p.2 ≠ u) {a b : Nat} (hr : ContractReach ce a b) :
    a = u ↔ b = u := by
  induction hr with
  | refl => exact Iff.rfl
  | step hab =>
    obtain ⟨p, hp, hcase⟩ := isContractPair_mem ce _ _ hab
    obtain ⟨h1, h2⟩ := hno p hp
    rcases hcase with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact ⟨fun h => False.elim (h1 h), fun h => False.elim (h2 h)⟩
    · exact ⟨fun h => False.elim (h2 h), fun h => False.elim (h1 h)⟩
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

theorem boolEq_true (a b : Bool) (h : boolEq a b = true) : a = b := by
  cases a <;> cases b <;> cases h <;> rfl

theorem ceAllClosed_spec (comp : List Nat) (ce : List (Nat × Nat))
    (h : ceAllClosed comp ce = true) :
    ∀ p ∈ ce, memNat p.1 comp = memNat p.2 comp := by
  induction ce with
  | nil => intro p hp; cases hp
  | cons p ps ih =>
    dsimp [ceAllClosed] at h
    simp only [Bool.and_eq_true] at h
    intro q hq
    rcases List.mem_cons.mp hq with rfl | hqps
    · exact boolEq_true _ _ h.1
    · exact ih h.2 q hqps

theorem contractReach_memNat (ce : List (Nat × Nat)) (comp : List Nat)
    (hclosed : ceAllClosed comp ce = true) {a b : Nat} (hr : ContractReach ce a b) :
    memNat a comp = memNat b comp := by
  have hspec := ceAllClosed_spec comp ce hclosed
  induction hr with
  | refl => rfl
  | step hab =>
    obtain ⟨p, hp, hcase⟩ := isContractPair_mem ce _ _ hab
    have he := hspec p hp
    rcases hcase with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact he
    · exact he.symm
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

theorem allNotMem_spec (comp : List Nat) (ce : List (Nat × Nat)) (u : Nat) (nbrs : List Nat)
    (h : allNotMem comp ce u nbrs = true) :
    ∀ v ∈ nbrs, isContractPair ce u v = true ∨ memNat v comp = false := by
  induction nbrs with
  | nil => intro v hv; cases hv
  | cons v vs ih =>
    dsimp [allNotMem] at h
    simp only [Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true'] at h
    intro w hw
    rcases List.mem_cons.mp hw with rfl | hwvs
    · exact h.1
    · exact ih h.2 w hwvs

theorem checkCELoops_spec (ceL : List (Nat × Nat)) (u0 : Nat) (rs : List (List Nat))
    (h : checkCELoops ceL u0 rs = true) :
    ∀ k (hk : k < rs.length), ∀ v ∈ rs[k], v ≠ u0 + k →
      ContractReach ceL (u0 + k) v → isContractPair ceL (u0 + k) v = true := by
  induction rs generalizing u0 with
  | nil => intro k hk; cases hk
  | cons nbrs rest ih =>
    dsimp [checkCELoops] at h
    simp only [Bool.and_eq_true] at h
    intro k hk v hv hne hreach
    cases k with
    | zero =>
      simp only [Nat.add_zero] at hv hne hreach ⊢
      cases hhas : ceHasVertex ceL u0 with
      | false =>
        have hno := ceHasVertex_false ceL u0 hhas
        have heq := (contractReach_no_vertex ceL u0 hno hreach).mp rfl
        exact absurd heq hne
      | true =>
        have h1 := h.1
        rw [hhas] at h1
        dsimp at h1
        simp only [Bool.and_eq_true] at h1
        have hmemu : memNat u0 (ceComp4 ceL u0) = true := h1.1.1
        have hclosed : ceAllClosed (ceComp4 ceL u0) ceL = true := h1.1.2
        have hall := allNotMem_spec (ceComp4 ceL u0) ceL u0 nbrs h1.2 v hv
        rcases hall with hcp | hnotmem
        · exact hcp
        · have hmemv := (contractReach_memNat ceL (ceComp4 ceL u0) hclosed hreach).symm.trans hmemu
          rw [hmemv] at hnotmem
          cases hnotmem
    | succ k' =>
      have := ih (u0 + 1) h.2 k' (Nat.lt_of_succ_lt_succ hk) v (by simpa using hv) (by omega)
        (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hreach)
      simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using this

theorem checkCEEdges_spec (r n : Nat) (adjMasks : List Nat) (ceL : List (Nat × Nat))
    (h : checkCEEdges r n adjMasks ceL = true) :
    ∀ p ∈ ceL, p.1 < n ∧ p.2 < n ∧ p.1 ≠ p.2 ∧
      Nat.testBit (listGetD 0 adjMasks p.1) p.2 = true ∧ ¬(p.1 < r ∧ p.2 < r) := by
  induction ceL with
  | nil => intro p hp; cases hp
  | cons p ps ih =>
    dsimp [checkCEEdges] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, testBit_and_one_eq,
      Bool.not_eq_true'] at h
    rcases h with ⟨⟨⟨⟨⟨hp1, hp2⟩, hne⟩, hbit⟩, hnrr⟩, hrest⟩
    intro q hq
    rcases List.mem_cons.mp hq with rfl | hqps
    · refine ⟨hp1, hp2, hne, hbit, ?_⟩
      intro hboth
      have : (decide (q.1 < r) && decide (q.2 < r)) = true := by simp [hboth.1, hboth.2]
      rw [this] at hnrr
      cases hnrr
    · exact ih hrest q hqps

theorem countCEInc_eq_filter_length (u : Nat) (ceL : List (Nat × Nat)) :
    countCEInc u ceL = (ceL.filter fun p => p.1 == u || p.2 == u).length := by
  induction ceL with
  | nil => rfl
  | cons p ps ih =>
    dsimp [countCEInc, List.filter]
    by_cases h : (p.1 == u || p.2 == u) = true
    · simp [h, ih]; omega
    · have hf : (p.1 == u || p.2 == u) = false := Bool.eq_false_iff.mpr h
      simp [hf, ih]

theorem checkContractRingDeg_spec (ceL : List (Nat × Nat)) (r : Nat)
    (h : checkContractRingDeg ceL r = true) :
    ∀ x < r, (ceL.filter fun p => p.1 == x || p.2 == x).length ≤ 1 := by
  induction r with
  | zero => intro x hx; cases hx
  | succ k ih =>
    dsimp [checkContractRingDeg] at h
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    intro x hx
    by_cases hxk : x = k
    · subst hxk
      rw [← countCEInc_eq_filter_length]
      exact h.1
    · exact ih h.2 x (by omega)

theorem checkListZipPrefix_spec (fcs : List FastConf) (rcs : List FastReducer.RConf)
    (h : checkListZipPrefix fcs rcs = true) (hlen : rcs.length ≤ fcs.length) :
    ∀ c (hc : c < rcs.length),
      checkConfEquiv (fcs[c]'(Nat.lt_of_lt_of_le hc hlen)) (rcs[c]'hc) = true := by
  induction fcs generalizing rcs with
  | nil =>
    cases rcs with
    | nil => intro c hc; cases hc
    | cons _ _ => simp at hlen
  | cons fc fcs ih =>
    cases rcs with
    | nil => intro c hc; cases hc
    | cons rc rcs =>
      dsimp [checkListZipPrefix] at h
      simp only [Bool.and_eq_true] at h
      have hlen' : rcs.length ≤ fcs.length := by simpa using hlen
      have h_ih := ih rcs h.2 hlen'
      intro c hc
      cases c with
      | zero => exact h.1
      | succ c' => exact h_ih c' (Nat.lt_of_succ_lt_succ hc)

theorem lookupListRec_eq_getElem {α : Type} (d : α) (xs : List α) (i : Nat) (hi : i < xs.length) :
    lookupListRec d xs i = xs[i] := by
  induction xs generalizing i with
  | nil => cases hi
  | cons _ _ ih =>
    cases i with
    | zero => rfl
    | succ k => exact ih k (Nat.lt_of_succ_lt_succ hi)

theorem flatten_getElem_chunk {α : Type} (m : Nat) (xs : List (List α)) (k c : Nat)
    (hk : k < xs.length) (hprev : ∀ i (hi : i < k), (xs[i]'(Nat.lt_trans hi hk)).length = m)
    (hc : c < xs[k].length) :
    ∃ hflat : m * k + c < xs.flatten.length,
      xs.flatten[m * k + c] = xs[k][c] := by
  induction xs generalizing k with
  | nil => cases hk
  | cons x rest ih =>
    cases k with
    | zero =>
      dsimp [List.flatten]
      have hc0 : c < x.length := hc
      have hflat : m * 0 + c < (x ++ rest.flatten).length := by
        rw [List.length_append]; omega
      refine ⟨hflat, ?_⟩
      simpa using List.getElem_append_left (bs := rest.flatten) hc0
    | succ k' =>
      have hxlen : x.length = m := hprev 0 (Nat.zero_lt_succ k')
      have hk' : k' < rest.length := Nat.lt_of_succ_lt_succ hk
      have hprev' : ∀ i (hi : i < k'), (rest[i]'(Nat.lt_trans hi hk')).length = m :=
        fun i hi => hprev (i + 1) (Nat.succ_lt_succ hi)
      have hc' : c < rest[k'].length := hc
      rcases ih k' hk' hprev' hc' with ⟨hflat', heq⟩
      have hmul : m * (k' + 1) = m + m * k' := by rw [Nat.mul_add, Nat.mul_one, Nat.add_comm]
      have hflat : m * (k' + 1) + c < (x :: rest).flatten.length := by
        dsimp [List.flatten]; rw [List.length_append, hxlen, hmul]; omega
      refine ⟨hflat, ?_⟩
      dsimp [List.flatten]
      have hge : x.length ≤ m * (k' + 1) + c := by rw [hxlen, hmul]; omega
      rw [List.getElem_append_right hge]
      have hidx : m * (k' + 1) + c - x.length = m * k' + c := by rw [hxlen, hmul]; omega
      simpa [hidx] using heq

theorem bit_chunk_arith (h : Nat) (hh : h < 633) :
    h >>> 6 < 10 ∧ (h >>> 3) &&& 7 < 8 ∧ h &&& 7 < 8 ∧
    8 * ((h >>> 3) &&& 7) + (h &&& 7) = h % 64 ∧
    64 * (h >>> 6) + (h % 64) = h ∧
    (h >>> 6 = 9 → ((h >>> 3) &&& 7 < 7 ∨ ((h >>> 3) &&& 7 = 7 ∧ h &&& 7 = 0))) := by
  have hs6 : h >>> 6 = h / 64 := by simp [Nat.shiftRight_eq_div_pow]
  have hs3 : h >>> 3 = h / 8 := by simp [Nat.shiftRight_eq_div_pow]
  have ha3 : (h / 8) &&& 7 = (h / 8) % 8 := Nat.and_two_pow_sub_one_eq_mod (h / 8) 3
  have ha0 : h &&& 7 = h % 8 := Nat.and_two_pow_sub_one_eq_mod h 3
  rw [hs6, hs3, ha3, ha0]
  refine ⟨by omega, by omega, by omega, by omega, by omega, ?_⟩
  intro h9
  omega

structure UnpackedEquiv (fc : FastConf) (rc : FastReducer.RConf) where
  adjMasks : List Nat
  earMasks : List Nat
  h_adjMasks : extractMasks (rc.adj.toList.map Array.toList) = some adjMasks
  h_earMasks : extractMasks (rc.earlier.toList.map Array.toList) = some earMasks
  h_hdr : checkHeaderEquiv fc rc (rc.adj.toList.map Array.toList) (rc.earlier.toList.map Array.toList) = true
  h_str : checkStructureEquiv fc rc (rc.adj.toList.map Array.toList) (rc.earlier.toList.map Array.toList) adjMasks earMasks = true
  h_qs : checkQStepEquiv fc rc adjMasks = true
  h_ce : checkContractSafety rc (rc.adj.toList.map Array.toList) adjMasks = true

theorem unpackCheckConfEquiv {fc : FastConf} {rc : FastReducer.RConf}
    (h : checkConfEquiv fc rc = true) : Nonempty (UnpackedEquiv fc rc) := by
  dsimp [checkConfEquiv] at h
  cases ham : extractMasks (rc.adj.toList.map Array.toList) with
  | none => simp [ham] at h
  | some adjMasks =>
    cases hem : extractMasks (rc.earlier.toList.map Array.toList) with
    | none => simp [ham, hem] at h
    | some earMasks =>
      simp only [ham, hem, Bool.and_eq_true] at h
      exact ⟨⟨adjMasks, earMasks, ham, hem, h.1.1.1, h.1.1.2, h.1.2, h.2⟩⟩

theorem adj_lengths_of_unpacked {fc : FastConf} {rc : FastReducer.RConf}
    (u : UnpackedEquiv fc rc) :
    (rc.adj.toList.map Array.toList).length = rc.n ∧
    (rc.earlier.toList.map Array.toList).length = rc.n := by
  have hhdr := u.h_hdr
  dsimp [checkHeaderEquiv] at hhdr
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hhdr
  rcases hhdr with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨_, _⟩, _⟩, _⟩, _⟩, _⟩, _⟩, _⟩, hadjLen⟩, hearLen⟩, _⟩
  exact ⟨hadjLen, hearLen⟩

theorem adj_eq_of_unpacked {fc : FastConf} {rc : FastReducer.RConf}
    (u : UnpackedEquiv fc rc) :
    let adjL := rc.adj.toList.map Array.toList
    adjL.length = rc.n ∧
    (rc.earlier.toList.map Array.toList).length = rc.n ∧
    u.adjMasks.length = rc.n ∧
    (∀ x (hx : x < rc.n),
      let row := adjL[x]'(by rw [(adj_lengths_of_unpacked u).1]; exact hx)
      row.Nodup ∧ (∀ v ∈ row, v < rc.n ∧ v ≠ x) ∧
      ∀ y, Nat.testBit (listGetD 0 u.adjMasks x) y = row.contains y) ∧
    (∀ x (hx : x < rc.n), ∀ y < rc.n,
      (configOfRConf rc).adj x y = (adjL[x]'(by rw [(adj_lengths_of_unpacked u).1]; exact hx)).contains y) := by
  obtain ⟨hadjLen, hearLen⟩ := adj_lengths_of_unpacked u
  have hstr := u.h_str
  dsimp [checkStructureEquiv] at hstr
  simp only [Bool.and_eq_true] at hstr
  have hsym := hstr.1.1.1
  obtain ⟨ham_len, ham_spec⟩ := extractMasks_spec _ _ u.h_adjMasks
  obtain ⟨hem_len, hem_spec⟩ := extractMasks_spec _ _ u.h_earMasks
  have hvs := checkVertAdjAndSym_spec rc.n 0 _ _ u.adjMasks u.earMasks ⟨ham_len, ham_spec⟩ ⟨hem_len, hem_spec⟩ hsym
  refine ⟨hadjLen, hearLen, by rw [ham_len, hadjLen], ?_, ?_⟩
  · intro x hx
    have h1 := ham_spec x (by rw [hadjLen]; exact hx)
    have h2 := (hvs x (by rw [hadjLen]; exact hx)).1
    exact ⟨h1.1, by simpa using h2, h1.2⟩
  · intro x hx y hy
    dsimp [configOfRConf, Math.symAdj]
    have hx_len : x < (rc.adj.toList.map Array.toList).length := by rw [hadjLen]; exact hx
    have hy_len : y < (rc.adj.toList.map Array.toList).length := by rw [hadjLen]; exact hy
    have hxr := hvs x hx_len
    have hear_list : ∀ k (hk : k < rc.n),
        (rc.earlier.getD k #[]).toList =
          (rc.earlier.toList.map Array.toList)[k]'(by rw [hearLen]; exact hk) := by
      intro k hk
      rw [array_getD_toList]
      have hk1 : k < rc.earlier.toList.length := by
        simpa [List.length_map] using (by rw [hearLen]; exact hk : k < (rc.earlier.toList.map Array.toList).length)
      rw [listGetD_eq_getElem #[] rc.earlier.toList hk1]
      simp
    by_cases hxy : x < y
    · rw [if_pos hxy, hear_list y hy]
      have hsymxy := hxr.2.2.2 y hy_len hxy
      simpa using hsymxy.symm
    · rw [if_neg hxy]
      by_cases hyx : y < x
      · rw [if_pos hyx, hear_list x hx]
        have heq := hxr.2.2.1 y (by simpa using hyx)
        simpa using heq.symm
      · rw [if_neg hyx]
        have hxy_eq : x = y := by omega
        subst hxy_eq
        symm
        cases hc : (rc.adj.toList.map Array.toList)[x].contains x with
        | false => rfl
        | true =>
          have hmem := List.contains_iff_mem.mp hc
          have hne := (hxr.1 x hmem).2
          omega

end Internal

