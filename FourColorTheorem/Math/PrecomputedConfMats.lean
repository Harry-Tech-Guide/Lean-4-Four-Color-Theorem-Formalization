def lookupListD {a : Type} (d : a) : List a -> Nat -> a
  | [], _ => d
  | x :: _, 0 => x
  | _ :: xs, n + 1 => lookupListD d xs n

def lookupFastConf (h : Nat) : FastConf :=
  let b0 := lookupListD [] fastConfTable (Nat.shiftRight h 6)
  let b1 := lookupListD [] b0 (Nat.land (Nat.shiftRight h 3) 7)
  lookupListD default b1 (Nat.land h 7)

